set -o pipefail

# Colors and formatting
bold="$(printf '\033[1m')"
dim="$(printf '\033[2m')"
green="$(printf '\033[32m')"
red="$(printf '\033[31m')"
yellow="$(printf '\033[33m')"
blue="$(printf '\033[34m')"
cyan="$(printf '\033[36m')"
magenta="$(printf '\033[35m')"
clean="$(printf '\033[0m')"

# Global state
CONFIG_DIR="/etc/eFa"
BACKUP_DIR="/var/eFa/backup"
TMP_DIR="/var/eFa/backup/tmp/migrate_$$"
SRC_CONFIGS_DIR="$TMP_DIR/src_configs"
TARGET_HOSTNAME="$(hostname -f 2>/dev/null || hostname)"
TARGET_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"

SRC_HOST=""
SRC_PORT="22"
SRC_USER="root"
SRC_HOSTNAME=""
SRC_VERSION=""
SRC_OS=""
SRC_MYSQLPWD=""
SRC_QUARANTINE_SIZE="0"
SRC_MAILWATCH_SIZE="0"
SRC_BAYES_SIZE="0"

# Target DB Credentials
TARGET_MYSQLPWD=""
if [[ -f "$CONFIG_DIR/MySQL-Config" ]]; then
    TARGET_MYSQLPWD="$(grep MYSQLROOTPWD "$CONFIG_DIR/MySQL-Config" | sed 's/.*://')"
fi

# Migration flags (defaults for full migration)
MIG_CONFIG=1
MIG_USERS=1
MIG_BAYES=1
MIG_QUARANTINE=1
MIG_HISTORY=1
MIG_HISTORY_RANGE="all" # all, 30d, 7d
MIG_GREY=1
MIG_GEOIP=1
MIG_CONFIG_MERGE=1
NON_INTERACTIVE=0
DO_SNAPSHOT=1

# Helper script location
AUDIT_SCRIPT="/usr/sbin/eFa-Migrate-Audit.php"
[[ ! -f "$AUDIT_SCRIPT" ]] && AUDIT_SCRIPT="/var/eFa/lib/eFa-Migrate-Audit.php"
[[ ! -f "$AUDIT_SCRIPT" ]] && AUDIT_SCRIPT="$(dirname "$0")/eFa-Migrate-Audit.php"

# Box border helpers
strip_ansi() {
    echo "$1" | sed -r "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[mGK]//g"
}

fmt_box_line() {
    local text="$1"
    local clean_text
    clean_text=$(strip_ansi "$text")
    local plain_len=${#clean_text}
    local pad_len=$(( 70 - plain_len ))
    [[ $pad_len -lt 0 ]] && pad_len=0
    local padding
    printf -v padding "%*s" "$pad_len" ""
    printf " ${cyan}│${clean}  %s%s${cyan}│${clean}\n" "$text" "$padding"
}

fmt_box_center() {
    local text="$1"
    local clean_text
    clean_text=$(strip_ansi "$text")
    local plain_len=${#clean_text}
    local total_pad=$(( 72 - plain_len ))
    [[ $total_pad -lt 0 ]] && total_pad=0
    local pad_l=$(( total_pad / 2 ))
    local pad_r=$(( total_pad - pad_l ))
    local padding_l padding_r
    printf -v padding_l "%*s" "$pad_l" ""
    printf -v padding_r "%*s" "$pad_r" ""
    printf " ${cyan}│${clean}%s%s%s${cyan}│${clean}\n" "$padding_l" "$text" "$padding_r"
}

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT INT TERM

echo_header() {
    if [[ $NON_INTERACTIVE -eq 0 ]]; then
        clear
    fi
    echo -e "${cyan}┌────────────────────────────────────────────────────────────────────────┐${clean}"
    echo -e "${cyan}│${clean}              ${bold}EFA-NG SERVER MIGRATION & BACKUP WIZARD${clean}                   ${cyan}│${clean}"
    echo -e "${cyan}│${clean}              https://efa-ng.space.ua  |  https://t.me/EFA_NG            ${cyan}│${clean}"
    echo -e "${cyan}└────────────────────────────────────────────────────────────────────────┘${clean}"
    echo ""
}

pause_prompt() {
    [[ $NON_INTERACTIVE -eq 1 ]] && return 0
    local msg="${1:-Press [Enter] to continue...}"
    echo -en "${dim}${msg}${clean} "
    read -r _dummy
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${red}[ERROR] eFa-Migrate must be run as root on the TARGET server.${clean}"
        exit 1
    fi
}

check_prerequisites() {
    local missing=()
    for tool in ssh rsync tar gzip mysql mysqldump php; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing+=("$tool")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${red}[ERROR] Missing required tools: ${missing[*]}${clean}"
        echo -e "${yellow}[INFO] Installing missing dependencies...${clean}"
        dnf -y install "${missing[@]}" || {
            echo -e "${red}[ERROR] Failed to install dependencies. Please install: ${missing[*]}${clean}"
            exit 1
        }
    fi

    if [[ -z "$TARGET_MYSQLPWD" ]]; then
        if [[ $NON_INTERACTIVE -eq 1 ]]; then
            echo -e "${red}[ERROR] MySQL root password not found in $CONFIG_DIR/MySQL-Config.${clean}"
            echo -e "       Automated migration cannot prompt for password non-interactively."
            exit 1
        fi
        echo -e "${yellow}[WARN] Could not find MySQL root password in $CONFIG_DIR/MySQL-Config.${clean}"
        echo -en "${green}[eFa-NG]${clean} Please enter Target MariaDB root password: "
        read -s TARGET_MYSQLPWD
        echo ""
    fi

    # Verify target local DB connection
    if ! mysql -u root -p"$TARGET_MYSQLPWD" -e "STATUS;" >/dev/null 2>&1; then
        echo -e "${red}[ERROR] Cannot connect to local Target MariaDB with root password.${clean}"
        exit 1
    fi

    mkdir -p "$BACKUP_DIR"
    mkdir -p "$SRC_CONFIGS_DIR"
}

# -----------------------------------------------------------------------------
# SSH Connection & Key Authorization
# -----------------------------------------------------------------------------
setup_ssh_connection() {
    if [[ $NON_INTERACTIVE -eq 0 ]]; then
        echo_header
        echo -e " ${bold}Step 1: Connect to Source EFA Server${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo -e " Run this wizard on the ${green}TARGET (new)${clean} server to pull data from your ${cyan}SOURCE (old)${clean} server."
        echo ""

        while true; do
            echo -en " ${green}[eFa-NG]${clean} Enter Source IP or FQDN: "
            read -r SRC_HOST
            SRC_HOST="$(echo "$SRC_HOST" | xargs)"
            if [[ -n "$SRC_HOST" ]]; then
                break
            fi
            echo -e " ${red}Source host cannot be empty.${clean}"
        done

        echo -en " ${green}[eFa-NG]${clean} Enter Source SSH Port [default: 22]: "
        read -r input_port
        input_port="$(echo "$input_port" | xargs)"
        if [[ -n "$input_port" ]]; then
            SRC_PORT="$input_port"
        fi

        echo -en " ${green}[eFa-NG]${clean} Enter Source SSH User [default: root]: "
        read -r input_user
        input_user="$(echo "$input_user" | xargs)"
        if [[ -n "$input_user" ]]; then
            SRC_USER="$input_user"
        fi
    else
        if [[ -z "$SRC_HOST" ]]; then
            echo -e "${red}[ERROR] Source host is required in automated/cron mode (--source=<host>).${clean}"
            exit 1
        fi
    fi

    echo ""
    echo -e " ${yellow}●${clean} Testing SSH connection to ${cyan}$SRC_USER@$SRC_HOST:$SRC_PORT${clean}..."

    while true; do
        local test_out
        test_out=$(ssh -p "$SRC_PORT" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$SRC_USER@$SRC_HOST" "echo EFA_AUTH_OK" 2>&1)
        local test_ret=$?

        if [[ $test_ret -eq 0 && "$test_out" == *"EFA_AUTH_OK"* ]]; then
            echo -e " ${green}✔ SSH authentication successful!${clean}"
            [[ $NON_INTERACTIVE -eq 0 ]] && sleep 1
            break
        fi

        # SSH failed - ensure target key exists
        local key_file="/root/.ssh/id_ed25519"
        local pub_file="/root/.ssh/id_ed25519.pub"
        if [[ ! -f "$pub_file" ]]; then
            if [[ -f "/root/.ssh/id_rsa.pub" ]]; then
                pub_file="/root/.ssh/id_rsa.pub"
            else
                echo -e " ${yellow}● Generating new SSH keypair on Target (ed25519)...${clean}"
                mkdir -p /root/.ssh && chmod 700 /root/.ssh
                ssh-keygen -t ed25519 -N "" -f "$key_file" -C "eFa-Migrate-$(hostname)" >/dev/null 2>&1
            fi
        fi

        local target_pubkey
        target_pubkey="$(cat "$pub_file" 2>/dev/null)"

        echo ""
        if [[ "$test_out" =~ "Connection refused" || "$test_out" =~ "Connection timed out" || "$test_out" =~ "No route to host" ]]; then
            echo -e " ${red}✖ Network connection failed: cannot reach $SRC_HOST on port $SRC_PORT.${clean}"
            echo -e "   ${dim}(Error: ${test_out})${clean}"
            echo -e "   Please verify that the host is online, SSH service is running, and firewall allows port $SRC_PORT."
        else
            echo -e " ${red}✖ SSH authentication failed: root access is not authorized or PermitRootLogin is disabled.${clean}"
        fi

        if [[ $NON_INTERACTIVE -eq 1 ]]; then
            echo -e "   SSH key authorization is missing on source server ($SRC_HOST)."
            echo -e "   Authorize target pubkey on $SRC_HOST with:"
            echo -e "   mkdir -p ~/.ssh && echo '$target_pubkey' >> ~/.ssh/authorized_keys && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys"
            exit 1
        fi

        echo ""
        echo -e " ${cyan}┌────────────────────────────────────────────────────────────────────────┐${clean}"
        fmt_box_center "${bold}SSH AUTHORIZATION ONELINER${clean}"
        echo -e " ${cyan}├────────────────────────────────────────────────────────────────────────┤${clean}"
        fmt_box_line "Open a terminal on your ${bold}SOURCE${clean} server (${cyan}$SRC_HOST${clean}) as root and run:"
        echo -e " ${cyan}│${clean}                                                                        ${cyan}│${clean}"
        echo -e " ${yellow}mkdir -p ~/.ssh && echo '$target_pubkey' >> ~/.ssh/authorized_keys && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys && (grep -q 'PermitRootLogin' /etc/ssh/sshd_config && sed -i -E 's/^#?[[:space:]]*PermitRootLogin[[:space:]]+.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config || echo 'PermitRootLogin prohibit-password' >> /etc/ssh/sshd_config) && (systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null || true)${clean}"
        echo -e " ${cyan}│${clean}                                                                        ${cyan}│${clean}"
        echo -e " ${cyan}└────────────────────────────────────────────────────────────────────────┘${clean}"
        echo ""
        echo -e " ${bold}Options:${clean}"
        echo -e "  [Enter] Re-test SSH connection"
        echo -e "  [c]     Change host/port/user"
        echo -e "  [q]     Quit migration"
        echo ""
        echo -en " ${green}[eFa-NG]${clean} Choice [Enter/c/q]: "
        local auth_choice
        read -r auth_choice

        case "$auth_choice" in
            q|Q)
                echo -e "${yellow}Migration cancelled by user.${clean}"
                exit 0
                ;;
            c|C)
                return 1
                ;;
            *)
                echo -e " ${yellow}● Re-testing connection...${clean}"
                ;;
        esac
    done

    return 0
}

# -----------------------------------------------------------------------------
# Source Inspection & System Discovery
# -----------------------------------------------------------------------------
inspect_source_system() {
    echo_header
    echo -e " ${bold}Step 2: Inspecting Source Server Environment${clean}"
    echo -e " ──────────────────────────────────────────────────────────────────"
    echo -e " ${yellow}●${clean} Gathering configuration and database details from ${cyan}$SRC_HOST${clean}..."

    # Remote info queries
    SRC_HOSTNAME=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "hostname -f 2>/dev/null || hostname" 2>/dev/null)
    SRC_VERSION=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "cat /etc/eFa-Version 2>/dev/null || echo 'Unknown'" 2>/dev/null)
    SRC_OS=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '\"' || uname -sr" 2>/dev/null)
    SRC_MYSQLPWD=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "grep MYSQLROOTPWD /etc/eFa/MySQL-Config 2>/dev/null | sed 's/.*://'" 2>/dev/null)

    # Validate remote DB
    local db_status="${green}Connected OK${clean}"
    if ! ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "mysql -u root -p'$SRC_MYSQLPWD' -e 'STATUS;' >/dev/null 2>&1"; then
        db_status="${red}Connection Failed (Check MySQL Password)${clean}"
    fi

    # Measure sizes
    SRC_QUARANTINE_SIZE=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "du -sh /var/spool/MailScanner/quarantine 2>/dev/null | awk '{print \$1}'" 2>/dev/null)
    [[ -z "$SRC_QUARANTINE_SIZE" ]] && SRC_QUARANTINE_SIZE="0B"

    SRC_MAILWATCH_SIZE=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "mysql -u root -p'$SRC_MYSQLPWD' -e 'SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 1) FROM information_schema.tables WHERE table_schema=\"mailscanner\";' -s -N 2>/dev/null" 2>/dev/null)
    [[ -z "$SRC_MAILWATCH_SIZE" ]] && SRC_MAILWATCH_SIZE="0"

    SRC_BAYES_SIZE=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "mysql -u root -p'$SRC_MYSQLPWD' -e 'SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 1) FROM information_schema.tables WHERE table_schema=\"sa_bayes\";' -s -N 2>/dev/null" 2>/dev/null)
    [[ -z "$SRC_BAYES_SIZE" ]] && SRC_BAYES_SIZE="0"

    # Download source configs for deep comparison
    echo -e " ${yellow}●${clean} Downloading configuration files and rule tables for parameter audit..."
    mkdir -p "$SRC_CONFIGS_DIR/extracted"
    ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "tar -czf - --ignore-failed-read \
        -C /var/www/html/mailscanner conf.php \
        -C /etc/MailScanner MailScanner.conf filename.rules.conf filetype.rules.conf archives.filename.rules.conf archives.filetype.rules.conf \
        -C /etc/MailScanner rules/ \
        -C /etc/mail/spamassassin local.cf \
        -C /etc/postfix transport recipient_access sender_access helo_access relay_domains sasl_passwd 2>/dev/null" \
        | tar -xzf - -C "$SRC_CONFIGS_DIR/extracted" 2>/dev/null || true

    ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" "postconf -n 2>/dev/null" > "$SRC_CONFIGS_DIR/extracted/postfix_postconf_n.txt" || true

fmt_profile_row() {
    local label="$1"
    local val_display="$2"
    local clean_plain
    clean_plain=$(echo "$val_display" | sed -r "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[mGK]//g")
    local plain_len=${#clean_plain}
    local pad_len=$(( 42 - plain_len ))
    [[ $pad_len -lt 0 ]] && pad_len=0
    local padding
    printf -v padding '%*s' "$pad_len" ''
    printf " ${cyan}│${clean}  %-24s : %s%s ${cyan}│${clean}\n" "$label" "$val_display" "$padding"
}

    echo ""
    echo -e " ${cyan}┌────────────────────────────────────────────────────────────────────────┐${clean}"
    echo -e " ${cyan}│${clean}                      ${bold}SOURCE SERVER PROFILE${clean}                             ${cyan}│${clean}"
    echo -e " ${cyan}├────────────────────────────────────────────────────────────────────────┤${clean}"
    fmt_profile_row "Source FQDN" "$SRC_HOSTNAME"
    fmt_profile_row "Source IP & Port" "$SRC_HOST:$SRC_PORT"
    fmt_profile_row "Operating System" "$SRC_OS"
    fmt_profile_row "eFa Version" "$SRC_VERSION"
    fmt_profile_row "MariaDB Database" "$db_status"
    echo -e " ${cyan}├────────────────────────────────────────────────────────────────────────┤${clean}"
    fmt_profile_row "MailWatch DB Size" "${SRC_MAILWATCH_SIZE} MB"
    fmt_profile_row "SpamAssassin Bayes DB" "${SRC_BAYES_SIZE} MB"
    fmt_profile_row "Quarantine Spool Size" "$SRC_QUARANTINE_SIZE"
    echo -e " ${cyan}└────────────────────────────────────────────────────────────────────────┘${clean}"
    echo ""
    pause_prompt "Review profile and press [Enter] to proceed to configuration audit..."
}

# -----------------------------------------------------------------------------
# Configuration Audit & Custom Differences Review
# -----------------------------------------------------------------------------
audit_and_select_configurations() {
    local audit_sum
    audit_sum=$(php "$AUDIT_SCRIPT" summary "$SRC_CONFIGS_DIR" 2>/dev/null)

    local c_conf=0
    local c_ms=0
    local c_pf=0
    local c_sa=0
    local c_ar=0
    local c_pr=0
    local c_pt=0
    local c_tot=0

    if [[ -n "$audit_sum" ]]; then
        c_conf=$(echo "$audit_sum" | grep -o '"conf_php":[0-9]*' | cut -d: -f2)
        c_ms=$(echo "$audit_sum" | grep -o '"mailscanner":[0-9]*' | cut -d: -f2)
        c_pf=$(echo "$audit_sum" | grep -o '"postfix":[0-9]*' | cut -d: -f2)
        c_sa=$(echo "$audit_sum" | grep -o '"spamassassin":[0-9]*' | cut -d: -f2)
        c_ar=$(echo "$audit_sum" | grep -o '"attachment_rules":[0-9]*' | cut -d: -f2)
        c_pr=$(echo "$audit_sum" | grep -o '"policy_rules":[0-9]*' | cut -d: -f2)
        c_pt=$(echo "$audit_sum" | grep -o '"postfix_tables":[0-9]*' | cut -d: -f2)
        c_tot=$(echo "$audit_sum" | grep -o '"total":[0-9]*' | cut -d: -f2)
    fi

    # By default, select all detected differences
    if [[ $MIG_CONFIG_MERGE -eq 1 ]]; then
        php "$AUDIT_SCRIPT" select-all "$SRC_CONFIGS_DIR" >/dev/null 2>&1
    else
        php "$AUDIT_SCRIPT" select-none "$SRC_CONFIGS_DIR" >/dev/null 2>&1
    fi

    if [[ $NON_INTERACTIVE -eq 1 ]]; then
        if [[ $MIG_CONFIG_MERGE -eq 1 ]]; then
            echo -e " ${green}✔ Automated mode: $c_tot detected custom parameters and rules selected for migration.${clean}"
        else
            echo -e " ${yellow}● Automated mode: custom parameters merge skipped as requested (--no-config-merge).${clean}"
        fi
        return 0
    fi

    while true; do
        echo_header
        echo -e " ${bold}Step 3: Configuration Audit & Non-Default Customizations${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo -e " Comparing source server configurations with Target defaults..."
        echo ""
        echo -e " ${cyan}┌────────────────────────────────────────────────────────────────────────┐${clean}"
        echo -e " ${cyan}│${clean}             ${bold}CUSTOMIZED CONFIGURATION PARAMETERS DETECTED${clean}               ${cyan}│${clean}"
        echo -e " ${cyan}├────────────────────────────────────────────────────────────────────────┤${clean}"
        printf " ${cyan}│${clean}  1) %-35s : %-28s ${cyan}│${clean}\n" "conf.php (MailWatch GUI)" "$c_conf custom settings"
        printf " ${cyan}│${clean}  2) %-35s : %-28s ${cyan}│${clean}\n" "MailScanner.conf (Filters)" "$c_ms customized directives"
        printf " ${cyan}│${clean}  3) %-35s : %-28s ${cyan}│${clean}\n" "main.cf (Postfix MTA)" "$c_pf non-default parameters"
        printf " ${cyan}│${clean}  4) %-35s : %-28s ${cyan}│${clean}\n" "local.cf (SpamAssassin)" "$c_sa custom rules / scores"
        printf " ${cyan}│${clean}  5) %-35s : %-28s ${cyan}│${clean}\n" "Attachment Rules (filename/filetype)" "$c_ar custom rules found"
        printf " ${cyan}│${clean}  6) %-35s : %-28s ${cyan}│${clean}\n" "Policy Rules (White/Blacklists)" "$c_pr custom entries found"
        printf " ${cyan}│${clean}  7) %-35s : %-28s ${cyan}│${clean}\n" "Postfix Tables (transport/relays)" "$c_pt custom records found"
        echo -e " ${cyan}├────────────────────────────────────────────────────────────────────────┤${clean}"
        printf " ${cyan}│${clean}  ${bold}%-38s : %-28s${clean} ${cyan}│${clean}\n" "Total Customizations Found" "$c_tot parameters / rules"
        echo -e " ${cyan}└────────────────────────────────────────────────────────────────────────┘${clean}"
        echo ""
        echo -e "  1) ${bold}Review & Select Parameters Individually${clean} (Interactive Checklist)"
        echo -e "  2) ${bold}Migrate All Detected Custom Parameters & Rules${clean} (Recommended)"
        echo -e "  3) ${bold}Skip Custom Parameters Merge${clean} (Keep Target Defaults)"
        echo ""
        echo -en " ${green}[eFa-NG]${clean} Choice [1, 2, 3]: "
        local c_opt
        read -r c_opt

        case "$c_opt" in
            1)
                interactive_config_review_menu "$c_conf" "$c_ms" "$c_pf" "$c_sa" "$c_ar" "$c_pr" "$c_pt"
                break
                ;;
            2)
                php "$AUDIT_SCRIPT" select-all "$SRC_CONFIGS_DIR" >/dev/null 2>&1
                echo -e " ${green}✔ All detected custom parameters and rules marked for migration.${clean}"
                sleep 1
                break
                ;;
            3)
                php "$AUDIT_SCRIPT" select-none "$SRC_CONFIGS_DIR" >/dev/null 2>&1
                echo -e " ${yellow}● Custom parameters merge skipped. Keeping Target defaults.${clean}"
                sleep 1
                break
                ;;
            *)
                echo -e "${red}Invalid option.${clean}"
                sleep 1
                ;;
        esac
    done
}

interactive_config_review_menu() {
    local c_conf="$1"
    local c_ms="$2"
    local c_pf="$3"
    local c_sa="$4"
    local c_ar="$5"
    local c_pr="$6"
    local c_pt="$7"

    while true; do
        echo_header
        echo -e " ${bold}Review & Select Configuration Files${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo -e " Select a file to inspect and toggle individual parameters:"
        echo ""
        echo -e "  1) conf.php         ($c_conf custom settings)"
        echo -e "  2) MailScanner.conf ($c_ms customized directives)"
        echo -e "  3) main.cf          ($c_pf non-default Postfix parameters)"
        echo -e "  4) local.cf         ($c_sa SpamAssassin custom rules)"
        echo -e "  5) Attachment Rules ($c_ar filename.rules.conf & filetype)"
        echo -e "  6) Policy Rules     ($c_pr spam.whitelist & policy rules)"
        echo -e "  7) Postfix Tables   ($c_pt transport & access maps)"
        echo ""
        echo -e "  A) Select All Across All Files"
        echo -e "  N) Deselect All"
        echo -e "  C) ${bold}Continue to Migration Scope${clean}"
        echo ""
        echo -en " ${green}[eFa-NG]${clean} Choice [1-7, A, N, C]: "
        local sub
        read -r sub

        case "$sub" in
            1) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" conf_php ;;
            2) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" mailscanner ;;
            3) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" postfix ;;
            4) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" spamassassin ;;
            5) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" attachment_rules ;;
            6) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" policy_rules ;;
            7) php "$AUDIT_SCRIPT" review "$SRC_CONFIGS_DIR" postfix_tables ;;
            a|A)
                php "$AUDIT_SCRIPT" select-all "$SRC_CONFIGS_DIR" >/dev/null 2>&1
                echo -e " ${green}✔ All items selected.${clean}"
                sleep 1
                ;;
            n|N)
                php "$AUDIT_SCRIPT" select-none "$SRC_CONFIGS_DIR" >/dev/null 2>&1
                echo -e " ${yellow}● All items deselected.${clean}"
                sleep 1
                ;;
            c|C)
                break
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Migration Mode Selection
# -----------------------------------------------------------------------------
choose_migration_mode() {
    if [[ $NON_INTERACTIVE -eq 1 ]]; then
        echo -e " ${bold}Step 4: Migration Scope${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo -e " ${green}✔ Automated mode: Executing Full Automated Migration.${clean}"
        echo -e "   Components: config=${MIG_CONFIG}, users=${MIG_USERS}, bayes=${MIG_BAYES}, quarantine=${MIG_QUARANTINE}, history=${MIG_HISTORY} (${MIG_HISTORY_RANGE}), grey=${MIG_GREY}, geoip=${MIG_GEOIP}"
        return 0
    fi

    while true; do
        echo_header
        echo -e " ${bold}Step 4: Select Migration Scope${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo ""
        echo -e " 1) ${bold}Full Automated Migration${clean} (Recommended)"
        echo -e "    Complete transfer of configuration, users, Bayes, quarantine,"
        echo -e "    and message history."
        echo ""
        echo -e " 2) ${bold}Selective Component Migration${clean} (Custom)"
        echo -e "    Interactively choose which specific components to transfer."
        echo ""
        echo -e " c) Cancel migration"
        echo ""
        echo -en " ${green}[eFa-NG]${clean} Choose mode [1, 2, c]: "
        local mode
        read -r mode

        case "$mode" in
            1)
                MIG_CONFIG=1
                MIG_USERS=1
                MIG_BAYES=1
                MIG_QUARANTINE=1
                MIG_HISTORY=1
                MIG_HISTORY_RANGE="all"
                MIG_GREY=1
                MIG_GEOIP=1
                break
                ;;
            2)
                configure_selective_components
                break
                ;;
            c|C)
                echo -e "${yellow}Migration cancelled.${clean}"
                exit 0
                ;;
            *)
                echo -e "${red}Invalid option.${clean}"
                sleep 1
                ;;
        esac
    done
}

configure_selective_components() {
    while true; do
        echo_header
        echo -e " ${bold}Step 4: Selective Component Configuration${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo -e " Toggle items on/off by typing their number, then press [C] to continue:"
        echo ""

        local mark_cfg="${red}[ ]${clean}"; [[ $MIG_CONFIG -eq 1 ]] && mark_cfg="${green}[✔]${clean}"
        local mark_usr="${red}[ ]${clean}"; [[ $MIG_USERS -eq 1 ]] && mark_usr="${green}[✔]${clean}"
        local mark_sa="${red}[ ]${clean}"; [[ $MIG_BAYES -eq 1 ]] && mark_sa="${green}[✔]${clean}"
        local mark_quar="${red}[ ]${clean}"; [[ $MIG_QUARANTINE -eq 1 ]] && mark_quar="${green}[✔]${clean}"
        local mark_hist="${red}[ ]${clean}"; [[ $MIG_HISTORY -eq 1 ]] && mark_hist="${green}[✔]${clean}"
        local mark_grey="${red}[ ]${clean}"; [[ $MIG_GREY -eq 1 ]] && mark_grey="${green}[✔]${clean}"
        local mark_geo="${red}[ ]${clean}"; [[ $MIG_GEOIP -eq 1 ]] && mark_geo="${green}[✔]${clean}"

        echo -e "  1) $mark_cfg Core Configs     (Postfix, MailScanner, DKIM/DMARC, TLS certs)"
        echo -e "  2) $mark_usr Users & Lists    (MailWatch web accounts, allowlists, blocklists)"
        echo -e "  3) $mark_sa SpamAssassin     (sa_bayes DB, tokens, local.cf, custom rules)"
        echo -e "  4) $mark_quar Quarantine       (Quarantine spool files & database records)"
        echo -e "  5) $mark_hist Message History  (maillog & mtalog - range: ${bold}$MIG_HISTORY_RANGE${clean})"
        echo -e "  6) $mark_grey Greylisting      (sqlgrey database & whitelists)"
        echo -e "  7) $mark_geo GeoIP & ASN      (MaxMind / strato-do GeoIP databases)"
        echo ""
        echo -e "  R) Toggle Message Range (all / 30d / 7d)"
        echo -e "  A) Enable All                N) Disable All"
        echo -e "  C) ${bold}Continue with Selected Components${clean}"
        echo ""
        echo -en " ${green}[eFa-NG]${clean} Toggle item or continue [1-7, R, A, N, C]: "
        local sel
        read -r sel

        case "$sel" in
            1) MIG_CONFIG=$((1 - MIG_CONFIG)) ;;
            2) MIG_USERS=$((1 - MIG_USERS)) ;;
            3) MIG_BAYES=$((1 - MIG_BAYES)) ;;
            4) MIG_QUARANTINE=$((1 - MIG_QUARANTINE)) ;;
            5) MIG_HISTORY=$((1 - MIG_HISTORY)) ;;
            6) MIG_GREY=$((1 - MIG_GREY)) ;;
            7) MIG_GEOIP=$((1 - MIG_GEOIP)) ;;
            r|R)
                if [[ "$MIG_HISTORY_RANGE" == "all" ]]; then
                    MIG_HISTORY_RANGE="30d"
                elif [[ "$MIG_HISTORY_RANGE" == "30d" ]]; then
                    MIG_HISTORY_RANGE="7d"
                else
                    MIG_HISTORY_RANGE="all"
                fi
                ;;
            a|A)
                MIG_CONFIG=1; MIG_USERS=1; MIG_BAYES=1; MIG_QUARANTINE=1; MIG_HISTORY=1; MIG_GREY=1; MIG_GEOIP=1 ;;
            n|N)
                MIG_CONFIG=0; MIG_USERS=0; MIG_BAYES=0; MIG_QUARANTINE=0; MIG_HISTORY=0; MIG_GREY=0; MIG_GEOIP=0 ;;
            c|C)
                break
                ;;
            *)
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Local Snapshot / Rollback Safety
# -----------------------------------------------------------------------------
create_target_snapshot() {
    if [[ $NON_INTERACTIVE -eq 1 ]]; then
        if [[ $DO_SNAPSHOT -eq 0 ]]; then
            echo -e " ${yellow}Skipping local snapshot as requested (--no-snapshot).${clean}"
            return 0
        fi
        echo -e " ${bold}Step 5: Safety Pre-Migration Snapshot${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
    else
        echo_header
        echo -e " ${bold}Step 5: Safety Pre-Migration Snapshot${clean}"
        echo -e " ──────────────────────────────────────────────────────────────────"
        echo -en " ${green}[eFa-NG]${clean} Create a local backup snapshot before applying changes? (Y/n): "
        local do_snap
        read -r do_snap

        if [[ "$do_snap" =~ ^[nN]$ ]]; then
            echo -e " ${yellow}Skipping local snapshot as requested.${clean}"
            sleep 1
            return 0
        fi
    fi

    local snap_name="pre-migration-$(date +%Y%m%d_%H%M%S)"
    local snap_dir="$TMP_DIR/$snap_name"
    mkdir -p "$snap_dir/sql" "$snap_dir/etc"

    echo -e " ${yellow}●${clean} Creating local database dump..."
    mysqldump -u root -p"$TARGET_MYSQLPWD" --all-databases --events > "$snap_dir/sql/databases.sql" 2>/dev/null || true

    echo -e " ${yellow}●${clean} Backing up local configurations..."
    mkdir -p "$snap_dir/etc/postfix" "$snap_dir/etc/MailScanner" "$snap_dir/etc/eFa" "$snap_dir/etc/mail"
    [[ -d /etc/postfix ]] && cp -a /etc/postfix "$snap_dir/etc/" 2>/dev/null || true
    [[ -d /etc/MailScanner ]] && cp -a /etc/MailScanner "$snap_dir/etc/" 2>/dev/null || true
    [[ -d /etc/eFa ]] && cp -a /etc/eFa "$snap_dir/etc/" 2>/dev/null || true
    [[ -d /etc/mail/spamassassin ]] && cp -a /etc/mail/spamassassin "$snap_dir/etc/mail/" 2>/dev/null || true

    tar -czf "$BACKUP_DIR/$snap_name.tar.gz" -C "$TMP_DIR" "$snap_name" 2>/dev/null
    rm -rf "$snap_dir"
    chmod 0600 "$BACKUP_DIR/$snap_name.tar.gz"

    echo -e " ${green}✔ Pre-migration snapshot created: $BACKUP_DIR/$snap_name.tar.gz${clean}"
    sleep 1
}

# -----------------------------------------------------------------------------
# Migration Execution
# -----------------------------------------------------------------------------
execute_migration() {
    echo_header
    echo -e " ${bold}Step 6: Executing Migration from ${cyan}$SRC_HOST${clean} to ${green}$TARGET_HOSTNAME${clean}"
    echo -e " ──────────────────────────────────────────────────────────────────"
    echo ""

    # 1. Core Configuration
    if [[ $MIG_CONFIG -eq 1 ]]; then
        echo -e " ${cyan}[1/7] Migrating Core Configurations & Applying Parameter Merges...${clean}"

        # Postfix maps & tables
        echo -e "       ${yellow}●${clean} Syncing Postfix lookup tables..."
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/postfix/" /etc/postfix/ \
            --exclude="*.pid" --exclude="prng_exch" --exclude="main.cf*" --exclude="master.cf*" \
            --exclude="dynamicmaps*" --exclude="postfix-files*" 2>/dev/null || true

        chown -R postfix:postfix /etc/postfix 2>/dev/null || true
        chown -R root:root /etc/postfix/dynamicmaps* 2>/dev/null || true

        # Rebuild Postfix maps
        for map in /etc/postfix/{transport,virtual,canonical,sender_canonical,recipient_canonical,sender_access,recipient_access,helo_access,header_checks,sasl_passwd,access}; do
            if [[ -f "$map" ]]; then
                postmap lmdb:"$map" 2>/dev/null || postmap "$map" 2>/dev/null || true
            fi
        done

        # OpenDKIM & OpenDMARC
        echo -e "       ${yellow}●${clean} Syncing OpenDKIM and OpenDMARC keys..."
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/opendkim/" /etc/opendkim/ 2>/dev/null || true
        chown -R opendkim:opendkim /etc/opendkim 2>/dev/null || true
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/opendmarc/" /etc/opendmarc/ 2>/dev/null || true
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/opendmarc.conf" /etc/opendmarc.conf 2>/dev/null || true
        chown -R opendmarc:opendmarc /etc/opendmarc 2>/dev/null || true

        # SSL Certificates
        echo -e "       ${yellow}●${clean} Syncing SSL/TLS certificates..."
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/letsencrypt/" /etc/letsencrypt/ 2>/dev/null || true

        # Apply specific audited parameter merges (conf.php, MailScanner.conf, Postfix main.cf, local.cf, rules)
        echo -e "       ${yellow}●${clean} Applying selected custom parameter merges..."
        php "$AUDIT_SCRIPT" apply "$SRC_CONFIGS_DIR" 2>/dev/null || true

        # Ensure all Postfix maps and session caches use lmdb on EL10
        sed -i -E 's/\bhash:/lmdb:/g; s/\btree:/lmdb:/g' /etc/postfix/main.cf 2>/dev/null || true
        sed -i -E 's/\bhash:/lmdb:/g; s/\btree:/lmdb:/g' /etc/postfix/master.cf 2>/dev/null || true
        postconf -e 'default_database_type = lmdb' 2>/dev/null || true
        postconf -e 'address_verify_map = lmdb:$data_directory/verify_cache' 2>/dev/null || true
        postconf -e 'postscreen_cache_map = lmdb:$data_directory/postscreen_cache' 2>/dev/null || true
        postconf -e 'smtp_tls_session_cache_database = lmdb:/var/lib/postfix/smtp_tls_session_cache' 2>/dev/null || true
        postconf -e 'smtpd_tls_session_cache_database = lmdb:/var/lib/postfix/smtpd_tls_session_cache' 2>/dev/null || true

        # Rebuild all Postfix maps with lmdb
        for map in /etc/postfix/{transport,virtual,canonical,sender_canonical,recipient_canonical,sender_access,recipient_access,helo_access,header_checks,sasl_passwd,access}; do
            if [[ -f "$map" ]]; then
                postmap lmdb:"$map" 2>/dev/null || postmap "$map" 2>/dev/null || true
            fi
        done
        postalias lmdb:/etc/aliases 2>/dev/null || newaliases 2>/dev/null || true
        systemctl reload postfix 2>/dev/null || postfix reload 2>/dev/null || true

        echo -e "       ${green}✔ Core configurations migrated and merged.${clean}"
    fi

    # 2. Users, Permissions & Lists
    if [[ $MIG_USERS -eq 1 ]]; then
        echo -e " ${cyan}[2/7] Migrating MailWatch Users, Permissions & Allow/Blocklists...${clean}"
        local existing_u_tables
        existing_u_tables=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
            "mysql -u root -p'$SRC_MYSQLPWD' -s -N -e 'SELECT table_name FROM information_schema.tables WHERE table_schema=\"mailscanner\" AND table_name IN (\"users\", \"user_filters\", \"user_preferences\", \"saved_filters\", \"user_dashboards\", \"whitelist\", \"blacklist\", \"autorelease\");' 2>/dev/null" | xargs)

        if [[ -n "$existing_u_tables" ]]; then
            echo -e "       ${yellow}●${clean} Transferring tables: $existing_u_tables..."
            ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
                "mysqldump -u root -p'$SRC_MYSQLPWD' --single-transaction mailscanner $existing_u_tables 2>/dev/null" \
                | mysql -u root -p"$TARGET_MYSQLPWD" mailscanner 2>/dev/null
            if [[ ${PIPESTATUS[0]} -eq 0 && ${PIPESTATUS[1]} -eq 0 ]]; then
                echo -e "       ${green}✔ Users, permissions, allowlists and blocklists migrated.${clean}"
            else
                echo -e "       ${red}✖ Warning: Error importing users/lists tables.${clean}"
            fi
        else
            echo -e "       ${yellow}● Warning: No user or list tables found on source.${clean}"
        fi
    fi

    # 3. SpamAssassin & Bayes
    if [[ $MIG_BAYES -eq 1 ]]; then
        echo -e " ${cyan}[3/7] Migrating SpamAssassin & Bayesian Database...${clean}"
        echo -e "       ${yellow}●${clean} Transferring sa_bayes SQL database..."
        ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
            "mysqldump -u root -p'$SRC_MYSQLPWD' --single-transaction sa_bayes 2>/dev/null" \
            | mysql -u root -p"$TARGET_MYSQLPWD" sa_bayes 2>/dev/null || true

        # Fix bayes user in DB
        mysql -u root -p"$TARGET_MYSQLPWD" sa_bayes -e "UPDATE bayes_vars SET username = 'postfix' WHERE id = '1';" 2>/dev/null || true

        # Transfer SpamAssassin custom configs
        echo -e "       ${yellow}●${clean} Syncing /etc/mail/spamassassin rules and local.cf..."
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/mail/spamassassin/" /etc/mail/spamassassin/ \
            --exclude="sa-update-keys" 2>/dev/null || true

        echo -e "       ${green}✔ SpamAssassin database and rules migrated.${clean}"
    fi

    # 4. Quarantine
    if [[ $MIG_QUARANTINE -eq 1 ]]; then
        echo -e " ${cyan}[4/7] Migrating Quarantine Spool & Database Records...${clean}"
        echo -e "       ${yellow}●${clean} Transferring quarantine database table..."
        ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
            "mysqldump -u root -p'$SRC_MYSQLPWD' --single-transaction mailscanner quarantine 2>/dev/null" \
            | mysql -u root -p"$TARGET_MYSQLPWD" mailscanner 2>/dev/null || true

        echo -e "       ${yellow}●${clean} Syncing quarantine spool files (/var/spool/MailScanner/quarantine)..."
        rsync -aHAX --info=progress2 -e "ssh -p $SRC_PORT" \
            "$SRC_USER@$SRC_HOST:/var/spool/MailScanner/quarantine/" /var/spool/MailScanner/quarantine/ 2>/dev/null || true

        chown -R postfix:apache /var/spool/MailScanner/quarantine 2>/dev/null || true
        chmod -R 770 /var/spool/MailScanner/quarantine 2>/dev/null || true
        echo -e "       ${green}✔ Quarantine migrated.${clean}"
    fi

    # 5. Message History & Logs
    if [[ $MIG_HISTORY -eq 1 ]]; then
        echo -e " ${cyan}[5/7] Migrating MailWatch Message History ($MIG_HISTORY_RANGE)...${clean}"
        local where_clause=""
        if [[ "$MIG_HISTORY_RANGE" == "30d" ]]; then
            where_clause="--where=\"timestamp >= DATE_SUB(NOW(), INTERVAL 30 DAY)\""
        elif [[ "$MIG_HISTORY_RANGE" == "7d" ]]; then
            where_clause="--where=\"timestamp >= DATE_SUB(NOW(), INTERVAL 7 DAY)\""
        fi

        local existing_log_tables
        existing_log_tables=$(ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
            "mysql -u root -p'$SRC_MYSQLPWD' -s -N -e 'SELECT table_name FROM information_schema.tables WHERE table_schema=\"mailscanner\" AND table_name IN (\"maillog\", \"mtalog\", \"inq\");' 2>/dev/null" | xargs)

        if [[ -n "$existing_log_tables" ]]; then
            echo -e "       ${yellow}●${clean} Transferring tables: $existing_log_tables..."
            ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
                "mysqldump -u root -p'$SRC_MYSQLPWD' --single-transaction --quick $where_clause mailscanner $existing_log_tables 2>/dev/null" \
                | mysql -u root -p"$TARGET_MYSQLPWD" mailscanner 2>/dev/null
            if [[ ${PIPESTATUS[0]} -eq 0 && ${PIPESTATUS[1]} -eq 0 ]]; then
                echo -e "       ${green}✔ Message logs migrated successfully.${clean}"
            else
                echo -e "       ${red}✖ Error importing message logs table.${clean}"
            fi
        fi

        # Update hostnames if different
        if [[ "$TARGET_HOSTNAME" != "$SRC_HOSTNAME" && -n "$SRC_HOSTNAME" ]]; then
            echo -e "       ${yellow}●${clean} Adapting log records to new hostname: $TARGET_HOSTNAME..."
            mysql -u root -p"$TARGET_MYSQLPWD" mailscanner -e "\
                UPDATE maillog SET hostname='$TARGET_HOSTNAME' WHERE hostname='$SRC_HOSTNAME';" 2>/dev/null || true
            mysql -u root -p"$TARGET_MYSQLPWD" mailscanner -e "\
                UPDATE mtalog SET host='$(hostname -s)' WHERE host='$(echo "$SRC_HOSTNAME" | cut -d. -f1)';" 2>/dev/null || true
        fi
    fi

    # 6. Greylisting
    if [[ $MIG_GREY -eq 1 ]]; then
        echo -e " ${cyan}[6/7] Migrating SQLGrey Greylisting Database...${clean}"
        ssh -p "$SRC_PORT" "$SRC_USER@$SRC_HOST" \
            "mysqldump -u root -p'$SRC_MYSQLPWD' --single-transaction sqlgrey 2>/dev/null" \
            | mysql -u root -p"$TARGET_MYSQLPWD" sqlgrey 2>/dev/null || true
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/etc/sqlgrey/" /etc/sqlgrey/ 2>/dev/null || true
        echo -e "       ${green}✔ Greylisting database migrated.${clean}"
    fi

    # 7. GeoIP Databases
    if [[ $MIG_GEOIP -eq 1 ]]; then
        echo -e " ${cyan}[7/7] Syncing GeoIP & ASN Database files...${clean}"
        mkdir -p /usr/share/GeoIP
        rsync -a -e "ssh -p $SRC_PORT" "$SRC_USER@$SRC_HOST:/usr/share/GeoIP/" /usr/share/GeoIP/ 2>/dev/null || true
        echo -e "       ${green}✔ GeoIP data synchronized.${clean}"
    fi

    # Finalization
    echo ""
    echo -e " ${bold}Finalizing & Optimizing Target System...${clean}"
    echo -e " ──────────────────────────────────────────────────────────────────"

    # Fix permissions
    echo -e " ${yellow}●${clean} Fixing file permissions..."
    chown -R apache:apache /var/www/html/mailscanner
    chmod -R 775 /var/www/html/mailscanner/temp

    # Re-run MailWatch DB upgrade script
    echo -e " ${yellow}●${clean} Running MailWatch database schema upgrade..."
    if [[ -f /usr/bin/mailwatch/tools/upgrade.php ]]; then
        /usr/bin/mailwatch/tools/upgrade.php --skip-user-confirm /var/www/html/mailscanner/functions.php >/dev/null 2>&1 || true
    fi

    # Clear dashboard cache
    rm -rf /var/www/html/mailscanner/temp/dash_cache/* 2>/dev/null || true

    # Reload / Restart services
    echo -e " ${yellow}●${clean} Restarting and reloading MailWatch services..."
    systemctl restart mariadb postfix mailscanner php-fpm httpd unbound 2>/dev/null || true
    systemctl restart opendkim opendmarc 2>/dev/null || true
    systemctl restart sqlgrey 2>/dev/null || true

    echo ""
    echo -e " ${cyan}┌────────────────────────────────────────────────────────────────────────┐${clean}"
    fmt_box_center "${bold}MIGRATION COMPLETED SUCCESSFULLY!${clean}"
    echo -e " ${cyan}├────────────────────────────────────────────────────────────────────────┤${clean}"
    fmt_box_line "All selected configurations, databases, and assets have been"
    fmt_box_line "transferred from ${cyan}$SRC_HOST${clean} to this server."
    fmt_box_line ""
    fmt_box_line "Web GUI URL : ${green}https://${TARGET_IP:-$TARGET_HOSTNAME}/mailscanner/${clean}"
    echo -e " ${cyan}└────────────────────────────────────────────────────────────────────────┘${clean}"
    echo ""
    pause_prompt "Press [Enter] to return..."
}

# -----------------------------------------------------------------------------
# CLI Help & Usage
# -----------------------------------------------------------------------------
show_help() {
    cat << 'EOF'
eFa-Migrate - EFA-NG Live Migration & Backup Transfer Wizard

Usage:
  eFa-Migrate [options]
  eFa-Migrate --cron --source=<host> [options]

Modes:
  Interactive (default) : Run without arguments to launch interactive TUI wizard.
  Automated / Cron      : Run with --cron (or --auto / --batch) and --source=<host>
                          for unattended full migration in a single line.

Options:
  -s, --source, --src=<host>     Source EFA server hostname or IP address (required in cron mode)
  -p, --port=<port>              SSH port on source server (default: 22)
  -u, --user=<user>              SSH user on source server (default: root)
  --cron, --auto, --batch, -y    Run non-interactively without prompts (Full Automated Migration)
  --full                         Execute full migration (all components, default)
  --history-range=<range>        Message history range to migrate: all, 30d, 7d (default: all)
  --no-snapshot, --skip-snapshot Do not create local safety backup snapshot before migration
  --snapshot                     Force creating local safety backup snapshot before migration
  --no-config-merge              Skip merging custom parameters from source configs (keep target defaults)
  --no-config                    Skip Postfix, MailScanner, DKIM/DMARC and SSL certs
  --no-users                     Skip MailWatch users, preferences, and allow/blocklists
  --no-bayes                     Skip SpamAssassin Bayes database and custom rules
  --no-quarantine                Skip quarantine spool files and database records
  --no-history                   Skip message history (maillog, mtalog)
  --no-grey                      Skip SQLGrey greylisting database
  --no-geoip                     Skip GeoIP database synchronization
  -h, --help                     Display this help message and exit
  -v, --version                  Display version information

Cron Examples:
  # Daily full automated migration from source server at 03:00
  0 3 * * * /usr/sbin/eFa-Migrate --cron --source=195.230.150.68 >> /var/log/eFa/eFa-Migrate.log 2>&1

  # Full automated migration with 30-day message history on custom SSH port
  eFa-Migrate --cron --source=old-efa.domain.com --port=2222 --history-range=30d

  # Quick sync without message history and without snapshot
  eFa-Migrate --cron --source=195.230.150.68 --no-history --no-snapshot

EOF
}

# -----------------------------------------------------------------------------
# Main Entry Point
# -----------------------------------------------------------------------------
main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "eFa-Migrate version 6.0.6 (EFA-NG)"
                exit 0
                ;;
            -s|--source|--src|--host)
                SRC_HOST="$2"
                shift 2
                ;;
            --source=*|--src=*|--host=*)
                SRC_HOST="${1#*=}"
                shift
                ;;
            -p|--port)
                SRC_PORT="$2"
                shift 2
                ;;
            --port=*)
                SRC_PORT="${1#*=}"
                shift
                ;;
            -u|--user)
                SRC_USER="$2"
                shift 2
                ;;
            --user=*)
                SRC_USER="${1#*=}"
                shift
                ;;
            --cron|--auto|--batch|-b|-y|--yes)
                NON_INTERACTIVE=1
                shift
                ;;
            --full)
                MIG_CONFIG=1; MIG_USERS=1; MIG_BAYES=1; MIG_QUARANTINE=1
                MIG_HISTORY=1; MIG_GREY=1; MIG_GEOIP=1
                shift
                ;;
            --history-range|--history)
                MIG_HISTORY_RANGE="$2"
                shift 2
                ;;
            --history-range=*|--history=*)
                MIG_HISTORY_RANGE="${1#*=}"
                shift
                ;;
            --no-snapshot|--skip-snapshot)
                DO_SNAPSHOT=0
                shift
                ;;
            --snapshot)
                DO_SNAPSHOT=1
                shift
                ;;
            --no-config-merge)
                MIG_CONFIG_MERGE=0
                shift
                ;;
            --no-config)
                MIG_CONFIG=0
                shift
                ;;
            --no-users)
                MIG_USERS=0
                shift
                ;;
            --no-bayes)
                MIG_BAYES=0
                shift
                ;;
            --no-quarantine)
                MIG_QUARANTINE=0
                shift
                ;;
            --no-history)
                MIG_HISTORY=0
                shift
                ;;
            --no-grey)
                MIG_GREY=0
                shift
                ;;
            --no-geoip)
                MIG_GEOIP=0
                shift
                ;;
            *)
                echo -e "${red}[ERROR] Unknown option: $1${clean}" >&2
                echo "Use --help to view available options." >&2
                exit 1
                ;;
        esac
    done

    check_root
    check_prerequisites

    while true; do
        if ! setup_ssh_connection; then
            continue
        fi
        break
    done

    inspect_source_system
    audit_and_select_configurations
    choose_migration_mode
    create_target_snapshot
    execute_migration
}

main "$@"
