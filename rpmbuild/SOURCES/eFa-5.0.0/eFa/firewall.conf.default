{
  "version": "1.0",
  "enabled": false,
  "allow_ping": true,
  "public_ports": [
    {
      "port": "25",
      "proto": "tcp",
      "comment": "SMTP Mail Server (Public)"
    }
  ],
  "admins": [
    {
      "ip": "127.0.0.1",
      "comment": "Localhost loopback"
    },
    {
      "ip": "::1",
      "comment": "IPv6 loopback"
    }
  ],
  "trusted": {
    "ports": [
      {
        "port": "3306",
        "proto": "tcp",
        "comment": "MariaDB Database"
      },
      {
        "port": "10050",
        "proto": "tcp",
        "comment": "Zabbix Agent"
      }
    ],
    "entries": []
  },
  "http_only": {
    "ports": [
      {
        "port": "80",
        "proto": "tcp",
        "comment": "HTTP Web Interface"
      },
      {
        "port": "443",
        "proto": "tcp",
        "comment": "HTTPS Secure Web Interface"
      }
    ],
    "entries": []
  },
  "mail_clients": {
    "ports": [
      {
        "port": "110",
        "proto": "tcp",
        "comment": "POP3 Mail Access"
      },
      {
        "port": "143",
        "proto": "tcp",
        "comment": "IMAP Mail Access"
      },
      {
        "port": "587",
        "proto": "tcp",
        "comment": "SMTP Submission"
      },
      {
        "port": "993",
        "proto": "tcp",
        "comment": "IMAPS Secure IMAP"
      },
      {
        "port": "995",
        "proto": "tcp",
        "comment": "POP3S Secure POP3"
      }
    ],
    "entries": []
  },
  "geoip": {
    "enabled": false,
    "global_blacklist": [],
    "groups": {
      "http_only": {
        "mode": "disabled",
        "countries": []
      },
      "mail_clients": {
        "mode": "disabled",
        "countries": []
      },
      "public_ports": {
        "mode": "disabled",
        "countries": []
      },
      "trusted": {
        "mode": "disabled",
        "countries": []
      }
    }
  }
}
