                    continue
                comm = Prompt.ask("Enter comment / description (e.g. Office LAN / Client Subnet)").strip()
                entries.append({"ip": norm, "comment": comm})
                save_config(cfg)
                apply_firewall(cfg)
                Prompt.ask("[bold green]● Entry added and applied! Press Enter...[/]")
        elif choice == "e":
            if not entries:
                continue
            idx_in = Prompt.ask(f"Enter entry number to edit comment [1-{len(entries)}]").strip()
            if idx_in.isdigit() and 1 <= int(idx_in) <= len(entries):
