            save_config(cfg)
            apply_firewall(cfg)
            status_str = "ENABLED (Restricted)" if cfg["enabled"] else "DISABLED (Open)"
            Prompt.ask(f"[bold green]● Protection mode set to {status_str}! Press [Enter] to continue...[/]")

def main():
    if os.geteuid() != 0:
        if RICH_AVAILABLE:
            console.print("[bold red]ERROR:[/] eFa-Firewall must be run as root.")
        else:
            print("[ERROR] eFa-Firewall must be run as root.")
        sys.exit(1)

    parser = argparse.ArgumentParser(description="EFA-NG Firewall & Access Control Manager (Rich TUI Edition)")
    parser.add_argument("--apply", action="store_true", help="Generate and apply firewall rules from config")
    parser.add_argument("--status", action="store_true", help="Show current firewall status")
    parser.add_argument("--list", action="store_true", help="List all firewall rules, IPs and comments in rich table")
    parser.add_argument("--enable", action="store_true", help="Enable firewall restriction mode")
    parser.add_argument("--disable", action="store_true", help="Disable firewall restriction mode (open mode)")
    parser.add_argument("--add", nargs=3, metavar=("GROUP", "IP", "COMMENT"), help="Add IP to group (admins, trusted, http_only)")
    parser.add_argument("--del", dest="delete", nargs=2, metavar=("GROUP", "IP"), help="Delete IP from group")
    parser.add_argument("--tui", action="store_true", help="Run interactive TUI console")

    args = parser.parse_args()
    cfg = load_config()

    if args.apply:
        success = apply_firewall(cfg)
        sys.exit(0 if success else 1)
    elif args.status:
        show_status(cfg)
        sys.exit(0)
    elif args.list:
        list_rules(cfg)
        sys.exit(0)
    elif args.enable:
        cfg["enabled"] = True
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.disable:
        cfg["enabled"] = False
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.add:
        group, ip, comment = args.add
        success = cli_add_entry(cfg, group, ip, comment)
        sys.exit(0 if success else 1)
    elif args.delete:
        group, ip = args.delete
        success = cli_del_entry(cfg, group, ip)
        sys.exit(0 if success else 1)
    else:
        # Default action: run interactive TUI
        interactive_tui()

if __name__ == "__main__":
    main()
