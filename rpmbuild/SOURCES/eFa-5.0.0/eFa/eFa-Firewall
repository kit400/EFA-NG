        action_table.add_row("[ B ]", "● Back to Main Menu")
        
        console.print(Panel(action_table, title="[bold white]● Available Actions[/]", box=box.ROUNDED, border_style="dim white"))

        choice = Prompt.ask("[bold green]Choose action [A/E/D/B][/]", choices=["a", "e", "d", "b", "q", ""], default="b").strip().lower()

        if choice in ["b", "q", ""]:
            break
        elif choice == "a":
            if group_name == "public_ports":
                port = Prompt.ask("Enter port number (e.g. 25, 587)").strip()
                if not port.isdigit():
                    console.print("[bold red]Invalid port number.[/]")
                    Prompt.ask("Press Enter to continue...")
                    continue
                proto = Prompt.ask("Enter protocol", choices=["tcp", "udp"], default="tcp").strip().lower()
                comm = Prompt.ask("Enter comment / description").strip()
                entries.append({"port": port, "proto": proto, "comment": comm})
                save_config(cfg)
                apply_firewall(cfg)
                Prompt.ask("[bold green]● Entry added and applied! Press Enter...[/]")
            else:
                ip_in = Prompt.ask("Enter IP address or CIDR subnet (e.g. 192.168.1.50 or 10.0.0.0/24)").strip()
                norm, ver = normalize_ip(ip_in)
                if not norm:
                    console.print("[bold red]Invalid IP or CIDR network format.[/]")
                    Prompt.ask("Press Enter to continue...")
                    continue
                comm = Prompt.ask("Enter comment / description (e.g. Admin Home / NOC / Monitoring)").strip()
                entries.append({"ip": norm, "comment": comm})
                save_config(cfg)
                apply_firewall(cfg)
                Prompt.ask("[bold green]● Entry added and applied! Press Enter...[/]")
        elif choice == "e":
            if not entries:
                continue
            idx_in = Prompt.ask(f"Enter entry number to edit comment [1-{len(entries)}]").strip()
            if idx_in.isdigit() and 1 <= int(idx_in) <= len(entries):
                target_item = entries[int(idx_in)-1]
                old_comm = target_item.get("comment", "")
                console.print(f"Current description: [yellow]{old_comm}[/]")
                new_comm = Prompt.ask("Enter new description", default=old_comm).strip()
                if new_comm:
                    target_item["comment"] = new_comm
                    save_config(cfg)
                    Prompt.ask("[bold green]● Comment updated! Press Enter...[/]")
            else:
                console.print("[bold red]Invalid entry number.[/]")
                Prompt.ask("Press Enter to continue...")
        elif choice == "d":
            if not entries:
                continue
            idx_in = Prompt.ask(f"Enter entry number to delete [1-{len(entries)}]").strip()
            if idx_in.isdigit() and 1 <= int(idx_in) <= len(entries):
                target_item = entries[int(idx_in)-1]
                del_desc = target_item.get("ip") or target_item.get("port")
                if Confirm.ask(f"Are you sure you want to delete [bold red]{del_desc}[/]?", default=False):
                    entries.pop(int(idx_in)-1)
                    save_config(cfg)
                    apply_firewall(cfg)
                    Prompt.ask("[bold green]● Deleted entry and reloaded firewall. Press Enter...[/]")
            else:
                console.print("[bold red]Invalid entry number.[/]")
                Prompt.ask("Press Enter to continue...")

