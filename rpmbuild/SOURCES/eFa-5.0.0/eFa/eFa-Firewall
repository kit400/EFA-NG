        res = subprocess.run(["firewall-cmd", "--state"], capture_output=True, text=True)
        if "running" in res.stdout:
            is_fw_active = True
    except Exception:
        pass

    enabled = cfg.get("enabled", True)
    
    print("\n" + f"{C_CYAN}┌────────────────────────────────────────────────────────────────────────┐{C_RESET}")
    print(f"{C_CYAN}│{C_RESET}                      {C_BOLD}EFA-NG FIREWALL STATUS{C_RESET}                            {C_CYAN}│{C_RESET}")
