def load_config():
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                dirty = False
                if "mail_clients" not in cfg:
                    cfg["mail_clients"] = {
                        "ports": [
                            {"port": "110", "proto": "tcp", "comment": "POP3 Mail Access"},
                            {"port": "143", "proto": "tcp", "comment": "IMAP Mail Access"},
                            {"port": "587", "proto": "tcp", "comment": "SMTP Submission"},
                            {"port": "993", "proto": "tcp", "comment": "IMAPS Secure IMAP"},
                            {"port": "995", "proto": "tcp", "comment": "POP3S Secure POP3"}
                        ],
                        "entries": []
                    }
                    dirty = True
                if "geoip" not in cfg:
                    cfg["geoip"] = {
                        "enabled": True,
                        "global_blacklist": [],
                        "groups": {
                            "http_only": {"mode": "disabled", "countries": []},
                            "mail_clients": {"mode": "disabled", "countries": []},
                            "public_ports": {"mode": "disabled", "countries": []},
                            "trusted": {"mode": "disabled", "countries": []}
                        }
                    }
                    dirty = True
                if dirty:
                    save_config(cfg)
                return cfg
        except Exception as e:
            if RICH_AVAILABLE:
                console.print(f"[bold red]ERROR:[/] Failed to parse {CONFIG_PATH}: {e}")
            else:
                print(f"[ERROR] Failed to parse {CONFIG_PATH}: {e}")
            sys.exit(1)
    elif os.path.exists(DEFAULT_CONFIG_PATH):
        try:
            with open(DEFAULT_CONFIG_PATH, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                save_config(cfg)
                return cfg
        except Exception:
            pass
    cfg = get_default_config()
    save_config(cfg)
    return cfg

def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp_path = CONFIG_PATH + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp_path, CONFIG_PATH)
    try:
        os.chmod(CONFIG_PATH, 0o640)
    except Exception:
        pass

def normalize_ip(ip_str):
    ip_str = ip_str.strip()
    try:
        net = ipaddress.ip_network(ip_str, strict=False)
        if net.num_addresses == 1:
            return str(net.network_address), net.version
        return str(net), net.version
    except ValueError:
        return None, None

# ----------------- GeoIP Fetch & Cache Engine -----------------
def fetch_country_zone(country_code, force=False):
    os.makedirs(GEOIP_CACHE_DIR, exist_ok=True)
    cc = country_code.strip().lower()
    f_v4 = os.path.join(GEOIP_CACHE_DIR, f"{cc}.zone")
    f_v6 = os.path.join(GEOIP_CACHE_DIR, f"{cc}6.zone")

    # Check cache freshness (refresh if older than 14 days or force)
    need_v4 = force or not os.path.exists(f_v4) or (time.time() - os.path.getmtime(f_v4) > 14 * 86400)
    need_v6 = force or not os.path.exists(f_v6) or (time.time() - os.path.getmtime(f_v6) > 14 * 86400)

    if need_v4:
        v4_lines = []
        # Try ipdeny.com
        try:
            url = f"http://www.ipdeny.com/ipblocks/data/countries/{cc}.zone"
            req = urllib.request.Request(url, headers={"User-Agent": "eFa-Firewall/6.0"})
            with urllib.request.urlopen(req, timeout=8) as resp:
                for line in resp.read().decode("utf-8", errors="ignore").splitlines():
                    line = line.strip()
                    if line and not line.startswith("#"):
                        v4_lines.append(line)
        except Exception:
            pass

        # Fallback to ipverse
        if not v4_lines:
            try:
                url = f"https://raw.githubusercontent.com/ipverse/rir-ip/master/country/{cc}/ipv4-aggregated.txt"
                req = urllib.request.Request(url, headers={"User-Agent": "eFa-Firewall/6.0"})
                with urllib.request.urlopen(req, timeout=8) as resp:
                    for line in resp.read().decode("utf-8", errors="ignore").splitlines():
                        line = line.strip()
                        if line and not line.startswith("#"):
                            v4_lines.append(line)
            except Exception:
                pass

        if v4_lines:
            with open(f_v4, "w", encoding="utf-8") as f:
                f.write("\n".join(v4_lines) + "\n")

    if need_v6:
        v6_lines = []
        try:
            url = f"https://raw.githubusercontent.com/ipverse/rir-ip/master/country/{cc}/ipv6-aggregated.txt"
            req = urllib.request.Request(url, headers={"User-Agent": "eFa-Firewall/6.0"})
            with urllib.request.urlopen(req, timeout=8) as resp:
                for line in resp.read().decode("utf-8", errors="ignore").splitlines():
                    line = line.strip()
                    if line and not line.startswith("#"):
                        v6_lines.append(line)
        except Exception:
            pass

        if v6_lines:
            with open(f_v6, "w", encoding="utf-8") as f:
                f.write("\n".join(v6_lines) + "\n")

def get_country_cidrs(country_code, auto_fetch=True):
    cc = country_code.strip().lower()
    f_v4 = os.path.join(GEOIP_CACHE_DIR, f"{cc}.zone")
    f_v6 = os.path.join(GEOIP_CACHE_DIR, f"{cc}6.zone")

    if auto_fetch and (not os.path.exists(f_v4) or not os.path.exists(f_v6)):
        fetch_country_zone(cc)

    v4_cidrs = set()
    v6_cidrs = set()

    if os.path.exists(f_v4):
        with open(f_v4, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    v4_cidrs.add(line)

    if os.path.exists(f_v6):
        with open(f_v6, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    v6_cidrs.add(line)

    return v4_cidrs, v6_cidrs

def update_all_geoip_caches(cfg, silent=False):
    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold cyan]● Updating GeoIP country CIDR zone caches...[/]")
        else:
            print("[eFa-Firewall] Updating GeoIP country CIDR zone caches...")

    countries = set()
    for item in cfg.get("geoip", {}).get("global_blacklist", []):
        c = item.get("country", "").strip().upper()
        if c:
            countries.add(c)

    for gname, gdata in cfg.get("geoip", {}).get("groups", {}).items():
        for item in gdata.get("countries", []):
            c = item.get("country", "").strip().upper()
            if c:
                countries.add(c)

    if not countries:
        if not silent:
            if RICH_AVAILABLE:
                console.print("[yellow]● No GeoIP countries configured.[/]")
            else:
                print("No GeoIP countries configured.")
        return

    for c in sorted(countries):
        if not silent and RICH_AVAILABLE:
            console.print(f"  Fetching CIDRs for [bold white]{c}[/] ({get_country_name(c)})...")
        fetch_country_zone(c, force=True)
        v4, v6 = get_country_cidrs(c, auto_fetch=False)
        if not silent and RICH_AVAILABLE:
            console.print(f"  [green]✔ {c}: {len(v4)} IPv4 CIDRs, {len(v6)} IPv6 CIDRs[/]")

    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold green]● GeoIP zone cache update complete.[/]")
        else:
            print("[eFa-Firewall] GeoIP zone cache update complete.")

# ----------------- Firewalld XML Generator -----------------
def write_firewalld_ipset_xml(name, description, entries, family="inet"):
    os.makedirs("/etc/firewalld/ipsets", exist_ok=True)
    xml_file = f"/etc/firewalld/ipsets/{name}.xml"
    
    lines = ['<?xml version="1.0" encoding="utf-8"?>']
    lines.append('<ipset type="hash:net">')
    lines.append(f'  <short>{name}</short>')
    lines.append(f'  <description>{description}</description>')
    lines.append('  <option name="maxelem" value="1000000"/>')
    if family == "inet6":
        lines.append('  <option name="family" value="inet6"/>')
    for e in sorted(entries):
        lines.append(f'  <entry>{e}</entry>')
    lines.append('</ipset>\n')
    
    with open(xml_file, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    os.chmod(xml_file, 0o644)

def apply_firewall(cfg, silent=False):
    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold cyan]● Generating and applying firewall configuration...[/]")
        else:
            print("[eFa-Firewall] Generating and applying firewall configuration...")
    
    enabled = cfg.get("enabled", True)
    
    if not enabled:
        if not silent:
            if RICH_AVAILABLE:
                console.print("[bold yellow]● Firewall protection is DISABLED in configuration. Restoring open mode...[/]")
            else:
                print("[eFa-Firewall] Firewall protection is DISABLED. Restoring open mode...")
        os.makedirs("/etc/firewalld/zones", exist_ok=True)
        public_xml = """<?xml version="1.0" encoding="utf-8"?>
<zone>
  <short>Public</short>
  <description>EFA-NG Unrestricted Mode</description>
  <service name="ssh"/>
  <service name="smtp"/>
  <service name="dhcpv6-client"/>
  <service name="http"/>
  <service name="https"/>
  <port port="80" protocol="tcp"/>
  <port port="443" protocol="tcp"/>
  <port port="110" protocol="tcp"/>
  <port port="143" protocol="tcp"/>
  <port port="587" protocol="tcp"/>
  <port port="993" protocol="tcp"/>
  <port port="995" protocol="tcp"/>
  <port port="3306" protocol="tcp"/>
  <port port="10050" protocol="tcp"/>
  <forward/>
</zone>
"""
        with open("/etc/firewalld/zones/public.xml", "w", encoding="utf-8") as f:
            f.write(public_xml)
        
        if os.path.exists("/etc/firewalld/zones/trusted.xml"):
            try:
                os.remove("/etc/firewalld/zones/trusted.xml")
            except Exception:
                pass

        res = subprocess.run(["firewall-cmd", "--reload"], capture_output=True, text=True)
        if res.returncode == 0:
            if not silent:
                if RICH_AVAILABLE:
                    console.print("[bold green]● Firewall successfully set to open mode.[/]")
                else:
                    print("[eFa-Firewall] Firewall successfully set to open mode.")
            return True
        else:
            if RICH_AVAILABLE:
                console.print(f"[bold red]ERROR:[/] Failed to reload firewalld: {res.stderr}")
            else:
                print(f"[ERROR] Failed to reload firewalld: {res.stderr}")
            return False

    # 1. Static IPs
    admin_v4 = set()
    admin_v6 = set()
    for item in cfg.get("admins", []):
        ip = item.get("ip", "")
        norm, ver = normalize_ip(ip)
        if ver == 4:
            admin_v4.add(norm)
        elif ver == 6:
            admin_v6.add(norm)

    admin_v4.add("127.0.0.1")
    admin_v6.add("::1")

    trusted_v4 = set()
    trusted_v6 = set()
    for item in cfg.get("trusted", {}).get("entries", []):
        ip = item.get("ip", "")
        norm, ver = normalize_ip(ip)
        if ver == 4:
            trusted_v4.add(norm)
        elif ver == 6:
            trusted_v6.add(norm)

    http_v4 = set()
    http_v6 = set()
    for item in cfg.get("http_only", {}).get("entries", []):
        ip = item.get("ip", "")
        norm, ver = normalize_ip(ip)
        if ver == 4:
            http_v4.add(norm)
        elif ver == 6:
            http_v6.add(norm)

    mail_v4 = set()
    mail_v6 = set()
    for item in cfg.get("mail_clients", {}).get("entries", []):
        ip = item.get("ip", "")
        norm, ver = normalize_ip(ip)
        if ver == 4:
            mail_v4.add(norm)
        elif ver == 6:
            mail_v6.add(norm)

    # 2. GeoIP Processing
    geo_cfg = cfg.get("geoip", {})
    geo_enabled = geo_cfg.get("enabled", True)

    # Global Blacklist
    geo_bl_v4 = set()
    geo_bl_v6 = set()
    if geo_enabled:
        for item in geo_cfg.get("global_blacklist", []):
            cc = item.get("country", "")
            if cc:
                v4, v6 = get_country_cidrs(cc)
                geo_bl_v4.update(v4)
                geo_bl_v6.update(v6)

    # Per-Group GeoIP Sets
    group_geo = geo_cfg.get("groups", {})

    def get_group_geo_cidrs(gname):
        wl_v4, wl_v6 = set(), set()
        bl_v4, bl_v6 = set(), set()
        if not geo_enabled:
            return "disabled", wl_v4, wl_v6, bl_v4, bl_v6

        gdata = group_geo.get(gname, {})
        mode = gdata.get("mode", "disabled").lower()
        if mode == "whitelist":
            for item in gdata.get("countries", []):
                cc = item.get("country", "")
                if cc:
                    v4, v6 = get_country_cidrs(cc)
                    wl_v4.update(v4)
                    wl_v6.update(v6)
        elif mode == "blacklist":
            for item in gdata.get("countries", []):
                cc = item.get("country", "")
                if cc:
                    v4, v6 = get_country_cidrs(cc)
                    bl_v4.update(v4)
                    bl_v6.update(v6)
        return mode, wl_v4, wl_v6, bl_v4, bl_v6

    http_geo_mode, http_gwl_v4, http_gwl_v6, http_gbl_v4, http_gbl_v6 = get_group_geo_cidrs("http_only")
    mail_geo_mode, mail_gwl_v4, mail_gwl_v6, mail_gbl_v4, mail_gbl_v6 = get_group_geo_cidrs("mail_clients")
    trust_geo_mode, trust_gwl_v4, trust_gwl_v6, trust_gbl_v4, trust_gbl_v6 = get_group_geo_cidrs("trusted")
    pub_geo_mode, pub_gwl_v4, pub_gwl_v6, pub_gbl_v4, pub_gbl_v6 = get_group_geo_cidrs("public_ports")

    # 3. Write IPSet XMLs
    write_firewalld_ipset_xml("efa_admins", "EFA-NG Admins (Full Access)", admin_v4, family="inet")
    if admin_v6:
        write_firewalld_ipset_xml("efa_admins6", "EFA-NG Admins IPv6 (Full Access)", admin_v6, family="inet6")
    
    write_firewalld_ipset_xml("efa_trusted", "EFA-NG Trusted Services", trusted_v4 or ["127.0.0.1"], family="inet")
    write_firewalld_ipset_xml("efa_http", "EFA-NG HTTP/HTTPS Access", http_v4 or ["127.0.0.1"], family="inet")
    write_firewalld_ipset_xml("efa_mail", "EFA-NG Mail Clients Access", mail_v4 or ["127.0.0.1"], family="inet")

    # Write GeoIP IPSet XMLs
    if geo_bl_v4:
        write_firewalld_ipset_xml("efa_geo_block_v4", "EFA-NG GeoIP Global Blacklist IPv4", geo_bl_v4, family="inet")
    if geo_bl_v6:
        write_firewalld_ipset_xml("efa_geo_block_v6", "EFA-NG GeoIP Global Blacklist IPv6", geo_bl_v6, family="inet6")

    # Group GeoIP IPSets
    if http_gwl_v4:
        write_firewalld_ipset_xml("efa_geo_http_wl_v4", "EFA-NG GeoIP HTTP Whitelist IPv4", http_gwl_v4, family="inet")
    if http_gwl_v6:
        write_firewalld_ipset_xml("efa_geo_http_wl_v6", "EFA-NG GeoIP HTTP Whitelist IPv6", http_gwl_v6, family="inet6")
    if http_gbl_v4:
        write_firewalld_ipset_xml("efa_geo_http_bl_v4", "EFA-NG GeoIP HTTP Blacklist IPv4", http_gbl_v4, family="inet")

    if mail_gwl_v4:
        write_firewalld_ipset_xml("efa_geo_mail_wl_v4", "EFA-NG GeoIP Mail Whitelist IPv4", mail_gwl_v4, family="inet")
    if mail_gwl_v6:
        write_firewalld_ipset_xml("efa_geo_mail_wl_v6", "EFA-NG GeoIP Mail Whitelist IPv6", mail_gwl_v6, family="inet6")
    if mail_gbl_v4:
        write_firewalld_ipset_xml("efa_geo_mail_bl_v4", "EFA-NG GeoIP Mail Blacklist IPv4", mail_gbl_v4, family="inet")

    if trust_gwl_v4:
        write_firewalld_ipset_xml("efa_geo_trust_wl_v4", "EFA-NG GeoIP Trusted Whitelist IPv4", trust_gwl_v4, family="inet")
    if trust_gbl_v4:
        write_firewalld_ipset_xml("efa_geo_trust_bl_v4", "EFA-NG GeoIP Trusted Blacklist IPv4", trust_gbl_v4, family="inet")

    if pub_gwl_v4:
        write_firewalld_ipset_xml("efa_geo_pub_wl_v4", "EFA-NG GeoIP Public Whitelist IPv4", pub_gwl_v4, family="inet")
    if pub_gbl_v4:
        write_firewalld_ipset_xml("efa_geo_pub_bl_v4", "EFA-NG GeoIP Public Blacklist IPv4", pub_gbl_v4, family="inet")

    # 4. Generate public.xml
    pub_lines = ['<?xml version="1.0" encoding="utf-8"?>']
    pub_lines.append('<zone>')
    pub_lines.append('  <short>Public</short>')
    pub_lines.append('  <description>EFA-NG Protected Zone</description>')
    pub_lines.append('  <service name="dhcpv6-client"/>')

    # If public_ports has port 25 and no GeoIP Whitelist restricting it, add smtp service
    has_port_25 = any(str(p.get("port", "")).strip() == "25" for p in cfg.get("public_ports", []))
    if has_port_25 and pub_geo_mode != "whitelist":
        pub_lines.append('  <service name="smtp"/>')

    # Other open public ports (if no public whitelist)
    for p in cfg.get("public_ports", []):
        port_num = str(p.get("port", "")).strip()
        proto = p.get("proto", "tcp").lower()
        if port_num and port_num != "25" and pub_geo_mode != "whitelist":
            pub_lines.append(f'  <port port="{port_num}" protocol="{proto}"/>')

    # Rule: Admins (Full Access) - Takes precedence
    pub_lines.append('  <rule family="ipv4">')
    pub_lines.append('    <source ipset="efa_admins"/>')
    pub_lines.append('    <accept/>')
    pub_lines.append('  </rule>')
    if admin_v6:
        pub_lines.append('  <rule family="ipv6">')
        pub_lines.append('    <source ipset="efa_admins6"/>')
        pub_lines.append('    <accept/>')
        pub_lines.append('  </rule>')

    # Rule: Global GeoIP Blacklist (Drop all traffic across all ports)
    if geo_bl_v4:
        pub_lines.append('  <rule family="ipv4">')
        pub_lines.append('    <source ipset="efa_geo_block_v4"/>')
        pub_lines.append('    <drop/>')
        pub_lines.append('  </rule>')
    if geo_bl_v6:
        pub_lines.append('  <rule family="ipv6">')
        pub_lines.append('    <source ipset="efa_geo_block_v6"/>')
        pub_lines.append('    <drop/>')
        pub_lines.append('  </rule>')

    # Rule: Group-specific GeoIP Blacklists (Drop)
    # HTTP Group BL
    if http_gbl_v4:
        for hp in cfg.get("http_only", {}).get("ports", [{"port": "80", "proto": "tcp"}, {"port": "443", "proto": "tcp"}]):
            pnum = str(hp.get("port", "")).strip()
            prt = hp.get("proto", "tcp").lower()
            if pnum:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_http_bl_v4"/><port port="{pnum}" protocol="{prt}"/><drop/></rule>')

    # Mail Clients Group BL
    if mail_gbl_v4:
        for mp in cfg.get("mail_clients", {}).get("ports", [{"port": "110", "proto": "tcp"}, {"port": "143", "proto": "tcp"}, {"port": "587", "proto": "tcp"}, {"port": "993", "proto": "tcp"}, {"port": "995", "proto": "tcp"}]):
            pnum = str(mp.get("port", "")).strip()
            prt = mp.get("proto", "tcp").lower()
            if pnum:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_mail_bl_v4"/><port port="{pnum}" protocol="{prt}"/><drop/></rule>')

    # Trusted Group BL
    if trust_gbl_v4:
        for tp in cfg.get("trusted", {}).get("ports", [{"port": "3306", "proto": "tcp"}, {"port": "10050", "proto": "tcp"}]):
            pnum = str(tp.get("port", "")).strip()
            prt = tp.get("proto", "tcp").lower()
            if pnum:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_trust_bl_v4"/><port port="{pnum}" protocol="{prt}"/><drop/></rule>')

    # Public Group BL
    if pub_gbl_v4:
        for pp in cfg.get("public_ports", []):
            pnum = str(pp.get("port", "")).strip()
            prt = pp.get("proto", "tcp").lower()
            if pnum:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_pub_bl_v4"/><port port="{pnum}" protocol="{prt}"/><drop/></rule>')

    # Rule: Trusted Ports (Static ACL + GeoIP Whitelist)
    trusted_ports = cfg.get("trusted", {}).get("ports", [{"port": "3306", "proto": "tcp"}, {"port": "10050", "proto": "tcp"}])
    for tp in trusted_ports:
        port_num = str(tp.get("port", "")).strip()
        proto = tp.get("proto", "tcp").lower()
        if port_num:
            pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_trusted"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')
            if trust_gwl_v4:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_trust_wl_v4"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')

    # Rule: HTTP / HTTPS Ports (Static ACL + GeoIP Whitelist)
    http_ports = cfg.get("http_only", {}).get("ports", [{"port": "80", "proto": "tcp"}, {"port": "443", "proto": "tcp"}])
    for hp in http_ports:
        port_num = str(hp.get("port", "")).strip()
        proto = hp.get("proto", "tcp").lower()
        if port_num:
            pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_http"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')
            if http_gwl_v4:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_http_wl_v4"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')
            if http_gwl_v6:
                pub_lines.append(f'  <rule family="ipv6"><source ipset="efa_geo_http_wl_v6"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')

    # Rule: Mail Clients Ports (Static ACL + GeoIP Whitelist)
    mail_ports = cfg.get("mail_clients", {}).get("ports", [{"port": "110", "proto": "tcp"}, {"port": "143", "proto": "tcp"}, {"port": "587", "proto": "tcp"}, {"port": "993", "proto": "tcp"}, {"port": "995", "proto": "tcp"}])
    for mp in mail_ports:
        port_num = str(mp.get("port", "")).strip()
        proto = mp.get("proto", "tcp").lower()
        if port_num:
            pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_mail"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')
            if mail_gwl_v4:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_mail_wl_v4"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')
            if mail_gwl_v6:
                pub_lines.append(f'  <rule family="ipv6"><source ipset="efa_geo_mail_wl_v6"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')

    # Rule: Public Ports (if Whitelisted by Country)
    if pub_geo_mode == "whitelist" and pub_gwl_v4:
        for pp in cfg.get("public_ports", []):
            port_num = str(pp.get("port", "")).strip()
            proto = pp.get("proto", "tcp").lower()
            if port_num:
                pub_lines.append(f'  <rule family="ipv4"><source ipset="efa_geo_pub_wl_v4"/><port port="{port_num}" protocol="{proto}"/><accept/></rule>')

    pub_lines.append('  <forward/>')
    pub_lines.append('</zone>\n')

    with open("/etc/firewalld/zones/public.xml", "w", encoding="utf-8") as f:
        f.write("\n".join(pub_lines))
    os.chmod("/etc/firewalld/zones/public.xml", 0o644)

    if os.path.exists("/etc/firewalld/zones/trusted.xml"):
        try:
            os.remove("/etc/firewalld/zones/trusted.xml")
        except Exception:
            pass

    # Reload firewalld
    res = subprocess.run(["firewall-cmd", "--reload"], capture_output=True, text=True)
    if res.returncode == 0:
        if not silent:
            if RICH_AVAILABLE:
                console.print("[bold green]● Firewall rules applied and reloaded successfully.[/]")
            else:
                print("[eFa-Firewall] Firewall rules applied and reloaded successfully.")
        return True
    else:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] Firewall reload returned error:\n{res.stderr}")
        else:
            print(f"[ERROR] Firewall reload returned error:\n{res.stderr}")
        return False

