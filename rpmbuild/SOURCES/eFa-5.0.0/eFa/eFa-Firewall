        print(f" {C_BOLD}│{C_RESET}  4) Public Ports (Open to the World: Port 25 SMTP)                     {C_BOLD}│{C_RESET}")
        print(f" {C_BOLD}└────────────────────────────────────────────────────────────────────────┘{C_RESET}")
        print(f" {C_BOLD}┌─ ACTIONS & TOOLS ──────────────────────────────────────────────────────┐{C_RESET}")
        print(f" {C_BOLD}│{C_RESET}  5) View All Rules & Comments Table                                    {C_BOLD}│{C_RESET}")
        print(f" {C_BOLD}│{C_RESET}  6) Apply Firewall Rules Now (Reload firewalld)                         {C_BOLD}│{C_RESET}")
        mode_toggle_label = "Disable Protection (Open Mode)" if cfg.get("enabled", True) else "Enable Protection (Restricted Mode)"
        print(f" {C_BOLD}│{C_RESET}  7) {mode_toggle_label:<67} {C_BOLD}│{C_RESET}")
        print(f" {C_BOLD}└────────────────────────────────────────────────────────────────────────┘{C_RESET}")
        print("")
        print(f"   {C_BOLD}0){C_RESET} Return to Configuration Console (Exit)")
        print("")
        choice = input(f" {C_GREEN}[eFa-NG]{C_RESET} : ").strip()

        if choice in ["0", "q", "exit"]:
            break
        elif choice == "1":
            manage_group_tui(cfg, "admins", "ADMINS LIST (FULL ACCESS)", "Access to ALL TCP/UDP ports and protocols")
        elif choice == "2":
            manage_group_tui(cfg, "trusted", "TRUSTED SERVICES", "Access to MariaDB (3306) and Zabbix-Agent (10050)")
        elif choice == "3":
            manage_group_tui(cfg, "http_only", "HTTP / HTTPS ACCESS", "Access to Web Management Interface (Ports 80 & 443)")
        elif choice == "4":
            manage_group_tui(cfg, "public_ports", "PUBLIC PORTS (WORLD OPEN)", "Ports open to entire world (0.0.0.0/0)")
        elif choice == "5":
            os.system("clear")
            list_rules(cfg)
            input("Press [Enter] to return...")
        elif choice == "6":
            apply_firewall(cfg)
            input("Press [Enter] to return...")
        elif choice == "7":
            cfg["enabled"] = not cfg.get("enabled", True)
            save_config(cfg)
            apply_firewall(cfg)
            input(f"{C_GREEN}Protection mode toggled. Press [Enter] to continue...{C_RESET}")

def main():
    if os.geteuid() != 0:
        print(f"{C_RED}[ERROR]{C_RESET} eFa-Firewall must be run as root.")
        sys.exit(1)

    parser = argparse.ArgumentParser(description="EFA-NG Firewall & Access Control Manager")
    parser.add_argument("--apply", action="store_true", help="Generate and apply firewall rules from config")
    parser.add_argument("--status", action="store_true", help="Show current firewall status")
    parser.add_argument("--list", action="store_true", help="List all firewall rules, IPs and comments")
    parser.add_argument("--enable", action="store_true", help="Enable firewall restriction mode")
    parser.add_argument("--disable", action="store_true", help="Disable firewall restriction mode (open mode)")
    parser.add_argument("--add", nargs=3, metavar=("GROUP", "IP", "COMMENT"), help="Add IP to group (admins, trusted, http_only)")
    parser.add_argument("--del", dest="delete", nargs=2, metavar=("GROUP", "IP"), help="Delete IP from group")
    parser.add_argument("--tui", action="store_true", help="Run interactive TUI console")

    args = parser.parse_args()
    cfg = load_config()

    if args.apply:
        success = apply_firewall(cfg)
        sys.exit(0 if success else 1)
    elif args.status:
        show_status(cfg)
        sys.exit(0)
    elif args.list:
        list_rules(cfg)
        sys.exit(0)
    elif args.enable:
        cfg["enabled"] = True
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.disable:
        cfg["enabled"] = False
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.add:
        group, ip, comment = args.add
        success = cli_add_entry(cfg, group, ip, comment)
        sys.exit(0 if success else 1)
    elif args.delete:
        group, ip = args.delete
        success = cli_del_entry(cfg, group, ip)
        sys.exit(0 if success else 1)
    else:
        # Default action: run interactive TUI
        interactive_tui()

if __name__ == "__main__":
    main()
