                save_config(cfg)
                apply_firewall(cfg)
                input(f"{C_GREEN}Entry added and applied. Press Enter...{C_RESET}")
            else:
                ip_in = input(" Enter IP address or CIDR (e.g. 192.168.1.100 or 10.0.0.0/24): ").strip()
                norm, ver = normalize_ip(ip_in)
