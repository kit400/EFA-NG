def cli_add_entry(cfg, group, ip, comment=""):
    norm, ver = normalize_ip(ip)
    if not norm:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] Invalid IP address or CIDR network: '{ip}'")
        else:
            print(f"[ERROR] Invalid IP: '{ip}'")
        return False

    group = group.lower()
    if group in ["admin", "admins"]:
        entries = cfg.setdefault("admins", [])
    elif group in ["trusted"]:
        entries = cfg.setdefault("trusted", {}).setdefault("entries", [])
    elif group in ["http", "http_only", "http-only", "web"]:
        entries = cfg.setdefault("http_only", {}).setdefault("entries", [])
    else:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] Unknown group '{group}'. Valid: admins, trusted, http_only")
        else:
            print(f"[ERROR] Unknown group '{group}'")
        return False

    # Check if already exists
    for item in entries:
        if item.get("ip") == norm:
            item["comment"] = comment or item.get("comment", "")
            if RICH_AVAILABLE:
                console.print(f"[bold yellow]● Updated existing entry {norm} in {group}: {item['comment']}[/]")
            else:
                print(f"Updated {norm} in {group}")
            save_config(cfg)
            apply_firewall(cfg)
            return True

    entries.append({"ip": norm, "comment": comment})
    save_config(cfg)
    if RICH_AVAILABLE:
        console.print(f"[bold green]● Added {norm} to {group} with comment: '{comment}'[/]")
    else:
        print(f"Added {norm} to {group}")
    apply_firewall(cfg)
    return True

def cli_del_entry(cfg, group, ip):
    norm, ver = normalize_ip(ip)
    target = norm if norm else ip.strip()

    group = group.lower()
    if group in ["admin", "admins"]:
        entries = cfg.get("admins", [])
    elif group in ["trusted"]:
        entries = cfg.get("trusted", {}).get("entries", [])
    elif group in ["http", "http_only", "http-only", "web"]:
        entries = cfg.get("http_only", {}).get("entries", [])
    else:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] Unknown group '{group}'. Valid: admins, trusted, http_only")
        else:
            print(f"[ERROR] Unknown group '{group}'")
        return False

    found = False
    for i, item in enumerate(entries):
        if item.get("ip") == target:
            del entries[i]
            found = True
            break

    if found:
        save_config(cfg)
        if RICH_AVAILABLE:
            console.print(f"[bold green]● Deleted {target} from {group}.[/]")
        else:
            print(f"Deleted {target} from {group}")
        apply_firewall(cfg)
        return True
    else:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] Entry {target} not found in {group}.")
        else:
            print(f"[ERROR] Entry {target} not found in {group}")
        return False

