            apply_firewall(cfg)
            Prompt.ask("[bold cyan]Press [Enter] to return to Main Menu...[/]")
        elif choice == "10":
            cfg["enabled"] = not cfg.get("enabled", True)
            save_config(cfg)
            apply_firewall(cfg)
            status_str = "ENABLED (Restricted)" if cfg["enabled"] else "DISABLED (Open)"
            Prompt.ask(f"[bold green]● Protection mode set to {status_str}! Press [Enter] to continue...[/]")

def main():
    if os.geteuid() != 0:
        if RICH_AVAILABLE:
            console.print("[bold red]ERROR:[/] eFa-Firewall must be run as root.")
        else:
            print("[ERROR] eFa-Firewall must be run as root.")
        sys.exit(1)

    parser = argparse.ArgumentParser(description="EFA-NG Firewall & Access Control Manager (Native NFTables & GeoIP)")
    parser.add_argument("--apply", action="store_true", help="Generate and apply native NFTables rules from config")
    parser.add_argument("--status", action="store_true", help="Show current firewall status")
    parser.add_argument("--list", action="store_true", help="List all firewall rules, IPs, GeoIP and comments in rich table")
    parser.add_argument("--enable", action="store_true", help="Enable firewall restriction mode")
    parser.add_argument("--disable", action="store_true", help="Disable firewall restriction mode (open mode)")
    parser.add_argument("--add", nargs=3, metavar=("GROUP", "IP", "COMMENT"), help="Add IP to group (admins, trusted, http_only, mail_clients)")
    parser.add_argument("--del", dest="delete", nargs=2, metavar=("GROUP", "IP"), help="Delete IP from group")
    parser.add_argument("--geoip-block-add", nargs="+", metavar=("COUNTRY", "[COMMENT]"), help="Add country to Global Blacklist")
    parser.add_argument("--geoip-block-del", metavar="COUNTRY", help="Delete country from Global Blacklist")
    parser.add_argument("--update-geoip", action="store_true", help="Download/update all configured country CIDR zone files")
    parser.add_argument("--tui", action="store_true", help="Run interactive TUI console")

    args = parser.parse_args()
    cfg = load_config()

    if args.apply:
        success = apply_firewall(cfg)
        sys.exit(0 if success else 1)
    elif args.status:
        show_status(cfg)
        sys.exit(0)
    elif args.list:
        list_rules(cfg)
        sys.exit(0)
    elif args.enable:
        cfg["enabled"] = True
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.disable:
        cfg["enabled"] = False
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.update_geoip:
        update_all_geoip_caches(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.add:
        group, ip, comment = args.add
        success = cli_add_entry(cfg, group, ip, comment)
        sys.exit(0 if success else 1)
    elif args.delete:
        group, ip = args.delete
        success = cli_del_entry(cfg, group, ip)
        sys.exit(0 if success else 1)
    elif args.geoip_block_add:
        cc = args.geoip_block_add[0].upper()
        comm = " ".join(args.geoip_block_add[1:]) if len(args.geoip_block_add) > 1 else get_country_name(cc)
        fetch_country_zone(cc)
        entries = cfg.setdefault("geoip", {}).setdefault("global_blacklist", [])
        found = False
        for it in entries:
            if it.get("country", "").upper() == cc:
                it["comment"] = comm
                found = True
                break
        if not found:
            entries.append({"country": cc, "comment": comm})
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    elif args.geoip_block_del:
        cc = args.geoip_block_del.upper()
        entries = cfg.get("geoip", {}).get("global_blacklist", [])
        cfg["geoip"]["global_blacklist"] = [it for it in entries if it.get("country", "").upper() != cc]
        save_config(cfg)
        apply_firewall(cfg)
        sys.exit(0)
    else:
        # Default action: run interactive TUI
        interactive_tui()

if __name__ == "__main__":
    main()
