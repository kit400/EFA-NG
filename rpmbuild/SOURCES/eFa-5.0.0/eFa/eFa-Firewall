            if idx_in.isdigit() and 1 <= int(idx_in) <= len(entries):
                del_item = entries.pop(int(idx_in)-1)
                save_config(cfg)
                apply_firewall(cfg)
                input(f"{C_GREEN}Deleted entry and applied changes. Press Enter...{C_RESET}")
            else:
                print(f"{C_RED}Invalid entry number.{C_RESET}")
                input("Press Enter to continue...")

def interactive_tui():
    cfg = load_config()
    while True:
        os.system("clear")
        show_status(cfg)
