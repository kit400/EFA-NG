                    print(f"{C_RED}Invalid IP / CIDR format.{C_RESET}")
                    input("Press Enter to continue...")
                    continue
                comm = input(" Enter comment / description: ").strip()
                entries.append({"ip": norm, "comment": comm})
                save_config(cfg)
                apply_firewall(cfg)
                input(f"{C_GREEN}Entry added and applied. Press Enter...{C_RESET}")
        elif choice == "e":
            idx_in = input(f" Enter entry number to edit [1-{len(entries)}]: ").strip()
            if idx_in.isdigit() and 1 <= int(idx_in) <= len(entries):
                target_item = entries[int(idx_in)-1]
