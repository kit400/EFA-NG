def load_config():
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                dirty = False
                if "mail_clients" not in cfg:
                    cfg["mail_clients"] = {
                        "ports": [
                            {"port": "110", "proto": "tcp", "comment": "POP3 Mail Access"},
                            {"port": "143", "proto": "tcp", "comment": "IMAP Mail Access"},
                            {"port": "587", "proto": "tcp", "comment": "SMTP Submission"},
                            {"port": "993", "proto": "tcp", "comment": "IMAPS Secure IMAP"},
                            {"port": "995", "proto": "tcp", "comment": "POP3S Secure POP3"}
                        ],
                        "entries": []
                    }
                    dirty = True
                if "geoip" not in cfg:
                    cfg["geoip"] = {
                        "enabled": True,
                        "global_blacklist": [],
                        "groups": {
                            "http_only": {"mode": "disabled", "countries": []},
                            "mail_clients": {"mode": "disabled", "countries": []},
                            "public_ports": {"mode": "disabled", "countries": []},
                            "trusted": {"mode": "disabled", "countries": []}
                        }
                    }
                    dirty = True
                if dirty:
                    save_config(cfg)
                return cfg
        except Exception as e:
            if RICH_AVAILABLE:
                console.print(f"[bold red]ERROR:[/] Failed to parse {CONFIG_PATH}: {e}")
            else:
                print(f"[ERROR] Failed to parse {CONFIG_PATH}: {e}")
            sys.exit(1)
    elif os.path.exists(DEFAULT_CONFIG_PATH):
        try:
            with open(DEFAULT_CONFIG_PATH, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                save_config(cfg)
                return cfg
        except Exception:
            pass
    cfg = get_default_config()
    save_config(cfg)
    return cfg

def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    tmp_path = CONFIG_PATH + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp_path, CONFIG_PATH)
    try:
        os.chmod(CONFIG_PATH, 0o640)
    except Exception:
        pass

def normalize_ip(ip_str):
    ip_str = ip_str.strip()
    try:
        net = ipaddress.ip_network(ip_str, strict=False)
        if net.num_addresses == 1:
            return str(net.network_address), net.version
        return str(net), net.version
    except ValueError:
        return None, None

# ----------------- GeoIP Fetch & Cache Engine -----------------
def fetch_country_zone(country_code, force=False):
    os.makedirs(GEOIP_CACHE_DIR, exist_ok=True)
    cc = country_code.strip().lower()
    f_v4 = os.path.join(GEOIP_CACHE_DIR, f"{cc}.zone")
    f_v6 = os.path.join(GEOIP_CACHE_DIR, f"{cc}6.zone")

    need_v4 = force or not os.path.exists(f_v4) or (time.time() - os.path.getmtime(f_v4) > 14 * 86400)
    need_v6 = force or not os.path.exists(f_v6) or (time.time() - os.path.getmtime(f_v6) > 14 * 86400)

    if need_v4:
        v4_lines = []
        try:
            url = f"http://www.ipdeny.com/ipblocks/data/countries/{cc}.zone"
            req = urllib.request.Request(url, headers={"User-Agent": "eFa-Firewall/6.0"})
            with urllib.request.urlopen(req, timeout=8) as resp:
                for line in resp.read().decode("utf-8", errors="ignore").splitlines():
                    line = line.strip()
                    if line and not line.startswith("#"):
                        v4_lines.append(line)
        except Exception:
            pass

        if not v4_lines:
            try:
                url = f"https://raw.githubusercontent.com/ipverse/rir-ip/master/country/{cc}/ipv4-aggregated.txt"
                req = urllib.request.Request(url, headers={"User-Agent": "eFa-Firewall/6.0"})
                with urllib.request.urlopen(req, timeout=8) as resp:
                    for line in resp.read().decode("utf-8", errors="ignore").splitlines():
                        line = line.strip()
                        if line and not line.startswith("#"):
                            v4_lines.append(line)
            except Exception:
                pass

        if v4_lines:
            with open(f_v4, "w", encoding="utf-8") as f:
                f.write("\n".join(v4_lines) + "\n")

    if need_v6:
        v6_lines = []
        try:
            url = f"https://raw.githubusercontent.com/ipverse/rir-ip/master/country/{cc}/ipv6-aggregated.txt"
            req = urllib.request.Request(url, headers={"User-Agent": "eFa-Firewall/6.0"})
            with urllib.request.urlopen(req, timeout=8) as resp:
                for line in resp.read().decode("utf-8", errors="ignore").splitlines():
                    line = line.strip()
                    if line and not line.startswith("#"):
                        v6_lines.append(line)
        except Exception:
            pass

        if v6_lines:
            with open(f_v6, "w", encoding="utf-8") as f:
                f.write("\n".join(v6_lines) + "\n")

def get_country_cidrs(country_code, auto_fetch=True):
    cc = country_code.strip().lower()
    f_v4 = os.path.join(GEOIP_CACHE_DIR, f"{cc}.zone")
    f_v6 = os.path.join(GEOIP_CACHE_DIR, f"{cc}6.zone")

    if auto_fetch and (not os.path.exists(f_v4) or not os.path.exists(f_v6)):
        fetch_country_zone(cc)

    v4_cidrs = set()
    v6_cidrs = set()

    if os.path.exists(f_v4):
        with open(f_v4, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    v4_cidrs.add(line)

    if os.path.exists(f_v6):
        with open(f_v6, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    v6_cidrs.add(line)

    return v4_cidrs, v6_cidrs

def update_all_geoip_caches(cfg, silent=False):
    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold cyan]● Updating GeoIP country CIDR zone caches...[/]")
        else:
            print("[eFa-Firewall] Updating GeoIP country CIDR zone caches...")

    countries = set()
    for item in cfg.get("geoip", {}).get("global_blacklist", []):
        c = item.get("country", "").strip().upper()
        if c:
            countries.add(c)

    for gname, gdata in cfg.get("geoip", {}).get("groups", {}).items():
        for item in gdata.get("countries", []):
            c = item.get("country", "").strip().upper()
            if c:
                countries.add(c)

    if not countries:
        if not silent:
            if RICH_AVAILABLE:
                console.print("[yellow]● No GeoIP countries configured.[/]")
            else:
                print("No GeoIP countries configured.")
        return

    for c in sorted(countries):
        if not silent and RICH_AVAILABLE:
            console.print(f"  Fetching CIDRs for [bold white]{c}[/] ({get_country_name(c)})...")
        fetch_country_zone(c, force=True)
        v4, v6 = get_country_cidrs(c, auto_fetch=False)
        if not silent and RICH_AVAILABLE:
            console.print(f"  [green]✔ {c}: {len(v4)} IPv4 CIDRs, {len(v6)} IPv6 CIDRs[/]")

    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold green]● GeoIP zone cache update complete.[/]")
        else:
            print("[eFa-Firewall] GeoIP zone cache update complete.")

# ----------------- Native NFTables Generator & Manager -----------------
def format_nft_set(name, type_str, elements):
    lines = []
    lines.append(f"    set {name} {{")
    lines.append(f"        type {type_str}")
    lines.append("        flags interval")
    if elements:
        sorted_elems = sorted(list(elements))
        # Format elements cleanly
        elem_str = ", ".join(sorted_elems)
        lines.append(f"        elements = {{ {elem_str} }}")
    lines.append("    }")
    return lines

def setup_nftables_persistence():
    os.makedirs("/etc/nftables", exist_ok=True)
    inc_line = f'include "{NFT_EFA_FILE}"'
    
    # 1. Check RHEL / CentOS sysconfig
    rhel_conf = "/etc/sysconfig/nftables.conf"
    if os.path.exists(os.path.dirname(rhel_conf)):
        has_inc = False
        if os.path.exists(rhel_conf):
            with open(rhel_conf, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
                if inc_line in content or NFT_EFA_FILE in content:
                    has_inc = True
        if not has_inc:
            with open(rhel_conf, "a", encoding="utf-8") as f:
                f.write(f"\n# Include EFA-NG Firewall Rules\n{inc_line}\n")

    # 2. Check Debian / Ubuntu /etc/nftables.conf
    deb_conf = "/etc/nftables.conf"
    if os.path.exists(deb_conf):
        has_inc = False
        with open(deb_conf, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()
            if inc_line in content or NFT_EFA_FILE in content:
                has_inc = True
        if not has_inc:
            with open(deb_conf, "a", encoding="utf-8") as f:
                f.write(f"\n# Include EFA-NG Firewall Rules\n{inc_line}\n")

    # 3. Disable conflicting firewalld if present
    try:
        subprocess.run(["systemctl", "disable", "--now", "firewalld"], capture_output=True, text=True)
    except Exception:
        pass

    # 4. Enable and start nftables.service
    try:
        subprocess.run(["systemctl", "enable", "--now", "nftables"], capture_output=True, text=True)
    except Exception:
        pass

def apply_firewall(cfg, silent=False):
    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold cyan]● Generating and applying native NFTables configuration...[/]")
        else:
            print("[eFa-Firewall] Generating and applying native NFTables configuration...")

    enabled = cfg.get("enabled", True)
    allow_ping = cfg.get("allow_ping", True)

    nft_lines = [
        "#!/usr/sbin/nft -f",
        "# +--------------------------------------------------------------------+",
        "# EFA-NG Native NFTables Configuration (Auto-Generated)",
        f"# Generated: {time.strftime('%Y-%m-%d %H:%M:%S')}",
        "# +--------------------------------------------------------------------+",
        "",
        "table inet efa",
        "delete table inet efa",
        "",
        "table inet efa {"
    ]

    if not enabled:
        # Open / Unrestricted Mode
        nft_lines.extend([
            "    chain input {",
            "        type filter hook input priority filter; policy accept;",
            "    }",
            "    chain forward {",
            "        type filter hook forward priority filter; policy accept;",
            "    }",
            "    chain output {",
            "        type filter hook output priority filter; policy accept;",
            "    }",
            "}"
        ])
    else:
        # 1. Parse Static IPs
        admin_v4, admin_v6 = set(), set()
        for item in cfg.get("admins", []):
            norm, ver = normalize_ip(item.get("ip", ""))
            if ver == 4: admin_v4.add(norm)
            elif ver == 6: admin_v6.add(norm)
        admin_v4.add("127.0.0.1")
        admin_v6.add("::1")

        trusted_v4, trusted_v6 = set(), set()
        for item in cfg.get("trusted", {}).get("entries", []):
            norm, ver = normalize_ip(item.get("ip", ""))
            if ver == 4: trusted_v4.add(norm)
            elif ver == 6: trusted_v6.add(norm)

        http_v4, http_v6 = set(), set()
        for item in cfg.get("http_only", {}).get("entries", []):
            norm, ver = normalize_ip(item.get("ip", ""))
            if ver == 4: http_v4.add(norm)
            elif ver == 6: http_v6.add(norm)

        mail_v4, mail_v6 = set(), set()
        for item in cfg.get("mail_clients", {}).get("entries", []):
            norm, ver = normalize_ip(item.get("ip", ""))
            if ver == 4: mail_v4.add(norm)
            elif ver == 6: mail_v6.add(norm)

        # 2. Parse GeoIP
        geo_cfg = cfg.get("geoip", {})
        geo_enabled = geo_cfg.get("enabled", True)

        geo_bl_v4, geo_bl_v6 = set(), set()
        if geo_enabled:
            for item in geo_cfg.get("global_blacklist", []):
                cc = item.get("country", "")
                if cc:
                    v4, v6 = get_country_cidrs(cc)
                    geo_bl_v4.update(v4)
                    geo_bl_v6.update(v6)

        group_geo = geo_cfg.get("groups", {})
        def get_grp_geo(gname):
            gwl_v4, gwl_v6 = set(), set()
            gbl_v4, gbl_v6 = set(), set()
            if not geo_enabled: return "disabled", gwl_v4, gwl_v6, gbl_v4, gbl_v6
            gdata = group_geo.get(gname, {})
            mode = gdata.get("mode", "disabled").lower()
            for it in gdata.get("countries", []):
                cc = it.get("country", "")
                if cc:
                    v4, v6 = get_country_cidrs(cc)
                    if mode == "whitelist":
                        gwl_v4.update(v4); gwl_v6.update(v6)
                    elif mode == "blacklist":
                        gbl_v4.update(v4); gbl_v6.update(v6)
            return mode, gwl_v4, gwl_v6, gbl_v4, gbl_v6

        http_mode, http_gwl_v4, http_gwl_v6, http_gbl_v4, http_gbl_v6 = get_grp_geo("http_only")
        mail_mode, mail_gwl_v4, mail_gwl_v6, mail_gbl_v4, mail_gbl_v6 = get_grp_geo("mail_clients")
        trust_mode, trust_gwl_v4, trust_gwl_v6, trust_gbl_v4, trust_gbl_v6 = get_grp_geo("trusted")
        pub_mode, pub_gwl_v4, pub_gwl_v6, pub_gbl_v4, pub_gbl_v6 = get_grp_geo("public_ports")

        # 3. Add NFTables Sets
        nft_lines.extend(format_nft_set("admins_v4", "ipv4_addr", admin_v4))
        nft_lines.extend(format_nft_set("admins_v6", "ipv6_addr", admin_v6))
        nft_lines.extend(format_nft_set("trusted_v4", "ipv4_addr", trusted_v4))
        nft_lines.extend(format_nft_set("trusted_v6", "ipv6_addr", trusted_v6))
        nft_lines.extend(format_nft_set("http_v4", "ipv4_addr", http_v4))
        nft_lines.extend(format_nft_set("http_v6", "ipv6_addr", http_v6))
        nft_lines.extend(format_nft_set("mail_v4", "ipv4_addr", mail_v4))
        nft_lines.extend(format_nft_set("mail_v6", "ipv6_addr", mail_v6))

        if geo_bl_v4 or geo_enabled:
            nft_lines.extend(format_nft_set("geo_block_v4", "ipv4_addr", geo_bl_v4))
        if geo_bl_v6 or geo_enabled:
            nft_lines.extend(format_nft_set("geo_block_v6", "ipv6_addr", geo_bl_v6))

        if http_mode == "whitelist":
            nft_lines.extend(format_nft_set("geo_http_wl_v4", "ipv4_addr", http_gwl_v4))
            nft_lines.extend(format_nft_set("geo_http_wl_v6", "ipv6_addr", http_gwl_v6))
        elif http_mode == "blacklist":
            nft_lines.extend(format_nft_set("geo_http_bl_v4", "ipv4_addr", http_gbl_v4))
            nft_lines.extend(format_nft_set("geo_http_bl_v6", "ipv6_addr", http_gbl_v6))

        if mail_mode == "whitelist":
            nft_lines.extend(format_nft_set("geo_mail_wl_v4", "ipv4_addr", mail_gwl_v4))
            nft_lines.extend(format_nft_set("geo_mail_wl_v6", "ipv6_addr", mail_gwl_v6))
        elif mail_mode == "blacklist":
            nft_lines.extend(format_nft_set("geo_mail_bl_v4", "ipv4_addr", mail_gbl_v4))
            nft_lines.extend(format_nft_set("geo_mail_bl_v6", "ipv6_addr", mail_gbl_v6))

        if trust_mode == "whitelist":
            nft_lines.extend(format_nft_set("geo_trust_wl_v4", "ipv4_addr", trust_gwl_v4))
            nft_lines.extend(format_nft_set("geo_trust_wl_v6", "ipv6_addr", trust_gwl_v6))
        elif trust_mode == "blacklist":
            nft_lines.extend(format_nft_set("geo_trust_bl_v4", "ipv4_addr", trust_gbl_v4))
            nft_lines.extend(format_nft_set("geo_trust_bl_v6", "ipv6_addr", trust_gbl_v6))

        if pub_mode == "whitelist":
            nft_lines.extend(format_nft_set("geo_pub_wl_v4", "ipv4_addr", pub_gwl_v4))
            nft_lines.extend(format_nft_set("geo_pub_wl_v6", "ipv6_addr", pub_gwl_v6))
        elif pub_mode == "blacklist":
            nft_lines.extend(format_nft_set("geo_pub_bl_v4", "ipv4_addr", pub_gbl_v4))
            nft_lines.extend(format_nft_set("geo_pub_bl_v6", "ipv6_addr", pub_gbl_v6))

        # Helper to format port strings
        def extract_ports(port_list, proto="tcp"):
            p_nums = []
            for p in port_list:
                if p.get("proto", "tcp").lower() == proto.lower():
                    p_num = str(p.get("port", "")).strip()
                    if p_num: p_nums.append(p_num)
            return p_nums

        # 4. Chain Input Rules
        nft_lines.append("")
        nft_lines.append("    chain input {")
        nft_lines.append("        type filter hook input priority filter; policy drop;")
        nft_lines.append("")
        nft_lines.append("        # 1. Established & Related state")
        nft_lines.append("        ct state established,related accept")
        nft_lines.append("        ct state invalid drop")
        nft_lines.append("")
        nft_lines.append("        # 2. Local loopback")
        nft_lines.append('        iif "lo" accept')
        nft_lines.append("")

        if allow_ping:
            nft_lines.append("        # 3. ICMP / Ping")
            nft_lines.append("        ip protocol icmp accept")
            nft_lines.append("        ip6 nexthdr ipv6-icmp accept")
            nft_lines.append("")

        nft_lines.append("        # 4. DHCPv6 Client")
        nft_lines.append("        ip6 daddr fe80::/64 udp dport 546 accept")
        nft_lines.append("")

        nft_lines.append("        # 5. Admins Full Access (Takes precedence)")
        nft_lines.append("        ip saddr @admins_v4 accept")
        nft_lines.append("        ip6 saddr @admins_v6 accept")
        nft_lines.append("")

        if geo_bl_v4 or geo_bl_v6:
            nft_lines.append("        # 6. Global Country Blacklist (Drop on ALL Ports)")
            if geo_bl_v4: nft_lines.append("        ip saddr @geo_block_v4 drop")
            if geo_bl_v6: nft_lines.append("        ip6 saddr @geo_block_v6 drop")
            nft_lines.append("")

        # 7. Group Blacklists
        http_tcp_ports = extract_ports(cfg.get("http_only", {}).get("ports", [{"port": "80"}, {"port": "443"}]), "tcp")
        mail_tcp_ports = extract_ports(cfg.get("mail_clients", {}).get("ports", [{"port": "110"}, {"port": "143"}, {"port": "587"}, {"port": "993"}, {"port": "995"}]), "tcp")
        trust_tcp_ports = extract_ports(cfg.get("trusted", {}).get("ports", [{"port": "3306"}, {"port": "10050"}]), "tcp")
        pub_tcp_ports = extract_ports(cfg.get("public_ports", [{"port": "25"}]), "tcp")

        if http_mode == "blacklist" and (http_gbl_v4 or http_gbl_v6) and http_tcp_ports:
            nft_lines.append(f"        # Group Blacklist: HTTP")
            p_str = ", ".join(http_tcp_ports)
            if http_gbl_v4: nft_lines.append(f"        ip saddr @geo_http_bl_v4 tcp dport {{ {p_str} }} drop")
            if http_gbl_v6: nft_lines.append(f"        ip6 saddr @geo_http_bl_v6 tcp dport {{ {p_str} }} drop")

        if mail_mode == "blacklist" and (mail_gbl_v4 or mail_gbl_v6) and mail_tcp_ports:
            nft_lines.append(f"        # Group Blacklist: Mail Clients")
            p_str = ", ".join(mail_tcp_ports)
            if mail_gbl_v4: nft_lines.append(f"        ip saddr @geo_mail_bl_v4 tcp dport {{ {p_str} }} drop")
            if mail_gbl_v6: nft_lines.append(f"        ip6 saddr @geo_mail_bl_v6 tcp dport {{ {p_str} }} drop")

        if trust_mode == "blacklist" and (trust_gbl_v4 or trust_gbl_v6) and trust_tcp_ports:
            nft_lines.append(f"        # Group Blacklist: Trusted")
            p_str = ", ".join(trust_tcp_ports)
            if trust_gbl_v4: nft_lines.append(f"        ip saddr @geo_trust_bl_v4 tcp dport {{ {p_str} }} drop")
            if trust_gbl_v6: nft_lines.append(f"        ip6 saddr @geo_trust_bl_v6 tcp dport {{ {p_str} }} drop")

        if pub_mode == "blacklist" and (pub_gbl_v4 or pub_gbl_v6) and pub_tcp_ports:
            nft_lines.append(f"        # Group Blacklist: Public Ports")
            p_str = ", ".join(pub_tcp_ports)
            if pub_gbl_v4: nft_lines.append(f"        ip saddr @geo_pub_bl_v4 tcp dport {{ {p_str} }} drop")
            if pub_gbl_v6: nft_lines.append(f"        ip6 saddr @geo_pub_bl_v6 tcp dport {{ {p_str} }} drop")

        # 8. Public Ports
        if pub_tcp_ports:
            p_str = ", ".join(pub_tcp_ports)
            if pub_mode == "whitelist":
                nft_lines.append("        # Public Ports (Restricted to Whitelist Countries)")
                if pub_gwl_v4: nft_lines.append(f"        ip saddr @geo_pub_wl_v4 tcp dport {{ {p_str} }} accept")
                if pub_gwl_v6: nft_lines.append(f"        ip6 saddr @geo_pub_wl_v6 tcp dport {{ {p_str} }} accept")
            else:
                nft_lines.append(f"        # Public World Ports (Open to 0.0.0.0/0)")
                nft_lines.append(f"        tcp dport {{ {p_str} }} accept")

        # 9. HTTP / HTTPS Web Management
        if http_tcp_ports:
            p_str = ", ".join(http_tcp_ports)
            nft_lines.append("        # HTTP / HTTPS Web Management")
            nft_lines.append(f"        ip saddr @http_v4 tcp dport {{ {p_str} }} accept")
            nft_lines.append(f"        ip6 saddr @http_v6 tcp dport {{ {p_str} }} accept")
            if http_mode == "whitelist":
                if http_gwl_v4: nft_lines.append(f"        ip saddr @geo_http_wl_v4 tcp dport {{ {p_str} }} accept")
                if http_gwl_v6: nft_lines.append(f"        ip6 saddr @geo_http_wl_v6 tcp dport {{ {p_str} }} accept")

        # 10. Mail Clients Access
        if mail_tcp_ports:
            p_str = ", ".join(mail_tcp_ports)
            nft_lines.append("        # Mail Clients & Submission")
            nft_lines.append(f"        ip saddr @mail_v4 tcp dport {{ {p_str} }} accept")
            nft_lines.append(f"        ip6 saddr @mail_v6 tcp dport {{ {p_str} }} accept")
            if mail_mode == "whitelist":
                if mail_gwl_v4: nft_lines.append(f"        ip saddr @geo_mail_wl_v4 tcp dport {{ {p_str} }} accept")
                if mail_gwl_v6: nft_lines.append(f"        ip6 saddr @geo_mail_wl_v6 tcp dport {{ {p_str} }} accept")

        # 11. Trusted Services
        if trust_tcp_ports:
            p_str = ", ".join(trust_tcp_ports)
            nft_lines.append("        # Trusted Services (MariaDB, Zabbix)")
            nft_lines.append(f"        ip saddr @trusted_v4 tcp dport {{ {p_str} }} accept")
            nft_lines.append(f"        ip6 saddr @trusted_v6 tcp dport {{ {p_str} }} accept")
            if trust_mode == "whitelist":
                if trust_gwl_v4: nft_lines.append(f"        ip saddr @geo_trust_wl_v4 tcp dport {{ {p_str} }} accept")
                if trust_gwl_v6: nft_lines.append(f"        ip6 saddr @geo_trust_wl_v6 tcp dport {{ {p_str} }} accept")

        nft_lines.append("    }")
        nft_lines.append("")
        nft_lines.append("    chain forward {")
        nft_lines.append("        type filter hook forward priority filter; policy accept;")
        nft_lines.append("    }")
        nft_lines.append("")
        nft_lines.append("    chain output {")
        nft_lines.append("        type filter hook output priority filter; policy accept;")
        nft_lines.append("    }")
        nft_lines.append("}")

    # Write file
    os.makedirs(os.path.dirname(NFT_EFA_FILE), exist_ok=True)
    tmp_file = NFT_EFA_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        f.write("\n".join(nft_lines) + "\n")
    os.chmod(tmp_file, 0o644)

    # Syntax check
    check_res = subprocess.run(["nft", "-c", "-f", tmp_file], capture_output=True, text=True)
    if check_res.returncode != 0:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] NFTables syntax verification failed:\n{check_res.stderr}")
        else:
            print(f"[ERROR] NFTables syntax verification failed:\n{check_res.stderr}")
        if os.path.exists(tmp_file): os.remove(tmp_file)
        return False

    os.replace(tmp_file, NFT_EFA_FILE)

    # Apply configuration atomically
    apply_res = subprocess.run(["nft", "-f", NFT_EFA_FILE], capture_output=True, text=True)
    if apply_res.returncode != 0:
        if RICH_AVAILABLE:
            console.print(f"[bold red]ERROR:[/] Failed to apply NFTables rules:\n{apply_res.stderr}")
        else:
            print(f"[ERROR] Failed to apply NFTables rules:\n{apply_res.stderr}")
        return False

    # Setup boot persistence and systemd service
    setup_nftables_persistence()

    if not silent:
        if RICH_AVAILABLE:
            console.print("[bold green]● NFTables firewall rules generated and applied successfully.[/]")
        else:
            print("[eFa-Firewall] NFTables firewall rules generated and applied successfully.")
    return True

