def cli_add_entry(cfg, group, ip, comment=""):
    norm, ver = normalize_ip(ip)
    if not norm:
        print(f"{C_RED}[ERROR]{C_RESET} Invalid IP address or CIDR network: '{ip}'")
        return False

    group = group.lower()
    if group in ["admin", "admins"]:
        entries = cfg.setdefault("admins", [])
    elif group in ["trusted"]:
        entries = cfg.setdefault("trusted", {}).setdefault("entries", [])
    elif group in ["http", "http_only", "http-only", "web"]:
        entries = cfg.setdefault("http_only", {}).setdefault("entries", [])
    else:
        print(f"{C_RED}[ERROR]{C_RESET} Unknown group '{group}'. Valid groups: admins, trusted, http_only")
        return False

    # Check if already exists
    for item in entries:
        if item.get("ip") == norm:
            item["comment"] = comment or item.get("comment", "")
            print(f"{C_YELLOW}[eFa-Firewall]{C_RESET} Updated existing entry {norm} in {group}: {item['comment']}")
            save_config(cfg)
            apply_firewall(cfg)
            return True

    entries.append({"ip": norm, "comment": comment})
    save_config(cfg)
    print(f"{C_GREEN}[eFa-Firewall]{C_RESET} Added {norm} to {group} with comment: '{comment}'")
    apply_firewall(cfg)
    return True

def cli_del_entry(cfg, group, ip):
    norm, ver = normalize_ip(ip)
    target = norm if norm else ip.strip()

    group = group.lower()
    if group in ["admin", "admins"]:
        entries = cfg.get("admins", [])
    elif group in ["trusted"]:
        entries = cfg.get("trusted", {}).get("entries", [])
    elif group in ["http", "http_only", "http-only", "web"]:
        entries = cfg.get("http_only", {}).get("entries", [])
    else:
        print(f"{C_RED}[ERROR]{C_RESET} Unknown group '{group}'. Valid groups: admins, trusted, http_only")
        return False

    found = False
    for i, item in enumerate(entries):
        if item.get("ip") == target:
            del entries[i]
            found = True
            break

    if found:
        save_config(cfg)
        print(f"{C_GREEN}[eFa-Firewall]{C_RESET} Deleted {target} from {group}.")
        apply_firewall(cfg)
        return True
    else:
        print(f"{C_RED}[ERROR]{C_RESET} Entry {target} not found in {group}.")
        return False

