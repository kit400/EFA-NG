  echo -e " 2) Classic Menu      - Traditional 2-column numbered text menu"
  echo -e " 3) TUI Dialog        - Fullscreen curses dialogs (whiptail)"
  echo ""
  echo -e " c) Cancel"
  echo ""
  echo -e -n "$green[eFa-NG]$clean Choose interface mode [1-3, c]: "
  local mode_choice
  read mode_choice || return 0
  case $mode_choice in
    1) UI_MODE="modern" ;;
    2) UI_MODE="classic" ;;
    3) UI_MODE="tui" ;;
    *) return 0 ;;
  esac
  mkdir -p /etc/eFa
  echo "UI_MODE=\"$UI_MODE\"" > "$CONFIG_FILE"
  echo ""
  echo -e "$green[eFa-NG]$clean Interface mode switched to $green$UI_MODE$clean and saved."
  sleep 1
}

# Choice dispatcher
func_dispatch_choice() {
  local choice="$1"
  case $choice in
    0) 
      clear
      SSHTTY=$(tty 2>/dev/null | sed -e 's/\/dev\///')
      if [ -n "$SSHTTY" ]; then
        SSHPID=$(ps aux | grep -E "sshd: [a-zA-Z]+@" | grep -w "$SSHTTY" | awk '{print $2}')
        [ -n "$SSHPID" ] && kill "$SSHPID" 2>/dev/null
      fi
      exit 0
      ;;
    1) exit 0 ;;
    2) func_reboot ;;
    3) func_halt ;;
    4) func_ip-settings ;;
    5) func_tunables ;;
    6) func_mailwatch-settings ;;
    7) func_mail-settings ;;
    8) func_spam-settings ;;
    9) func_recover-mariadb ;;
    10) func_apache-settings ;;
    11) func_virus-settings ;;
    12) func_system-restore ;;
    13) func_update-now ;;
    14) func_maintenance-mode ;;
    15) func_lets-encrypt ;;
    16) func_dkim-dmarc ;;
    17) func_webmin ;;
    18) func_fail2ban ;;
    19) func_backup-settings ;;
    M|m) func_switch_ui_mode ;;
    T|t) UI_MODE="tui"; func_tui_menu ;;
    R|r) return 0 ;;
    *) echo -e "Error \"$choice\" is not an option..." && sleep 1 ;;
  esac
}

fmt_full_row() {
  local label="$1"
  local val="$2"
  local content="${label} : ${val}"
  if [ ${#content} -gt 68 ]; then
    content="${content:0:65}..."
  fi
  printf " ${cyan}│${clean}  %-68.68s  ${cyan}│${clean}\n" "$content"
}

fmt_split_row() {
  local l_label="$1"
  local l_val="$2"
  local r_label="$3"
  local r_val="$4"
  
  local left="${l_label} : ${l_val}"
  if [ ${#left} -gt 41 ]; then
    left="${left:0:38}..."
  fi
  local right="${r_label} : ${r_val}"
  if [ ${#right} -gt 26 ]; then
    right="${right:0:23}..."
  fi
  printf " ${cyan}│${clean}  %-42.42s%-26.26s  ${cyan}│${clean}\n" "$left" "$right"
}

