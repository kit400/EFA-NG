# TUI (Whiptail) Menu
func_tui_menu() {
  if ! command -v whiptail >/dev/null 2>&1; then
    echo -e "$red[ERROR]$clean whiptail is not installed. Falling back to Modern CLI."
    UI_MODE="modern"
    sleep 1
    return 0
  fi

  while true; do
    CHOICE=$(whiptail --title "EFA-NG Configuration Console" \
      --backtitle "EFA-NG Project (https://efa-ng.space.ua | Support: https://t.me/EFA_NG)" \
      --menu "Select an option using arrow keys and press Enter:" 24 76 16 \
      "1"  "Shell (Exit to Bash)" \
      "2"  "Reboot System" \
      "3"  "Halt System" \
      "4"  "IP & DNS Settings" \
      "5"  "System Tunables (Threads)" \
      "6"  "MailWatch Settings" \
      "7"  "Mail Settings (Relay/Domains)" \
      "8"  "Spam Filter Settings" \
      "9"  "MariaDB Database Recovery" \
      "10" "Apache & HTTPS Settings" \
      "11" "Virus & Clean Delivery Settings" \
      "12" "Backup & Server Migration Wizard" \
      "13" "Update System & Packages" \
      "14" "Maintenance Mode Toggle" \
      "15" "Let's Encrypt SSL Certificates" \
      "16" "DKIM and DMARC Wizard" \
      "17" "Webmin Control Panel" \
      "18" "Fail2Ban Protection" \
      "19" "Auto-Backup Settings" \
      "M"  "Switch UI Mode (Classic / Modern / TUI)" \
      "0"  "Logout from SSH" \
      3>&1 1>&2 2>&3)
    
    local ret=$?
    if [ $ret -ne 0 ]; then
      # User pressed Cancel or Esc
      clear
      echo -e "$green[eFa-NG]$clean Exited TUI."
      exit 0
    fi
    
    func_dispatch_choice "$CHOICE"
    
    # If mode was switched away from TUI, exit loop so main dispatcher takes over
    if [ "$UI_MODE" != "tui" ]; then
      break
    fi
  done
}

# Main entry point
if [ `whoami` == root ]; then
  while true; do
    if [ "$UI_MODE" == "tui" ]; then
      func_tui_menu
      exit 0
    elif [ "$UI_MODE" == "classic" ]; then
      show_classic_menu
    else
      show_modern_menu
    fi
  done
else
  echo -e "$red [eFa-NG] ERROR: Please become root.$clean"
  exit 0
fi
