# Update Now function
func_update-now() {
  func_echo-header
  echo -e "$green[eFa-NG]$clean - System & Package Update"
  echo ""
  echo -e "Checking for available package updates..."
  echo ""
  dnf --refresh check-update
  local dnf_status=$?
  if [ $dnf_status -eq 0 ]; then
    echo ""
    echo -e "$green[eFa-NG]$clean All packages are up to date."
    echo ""
  elif [ $dnf_status -eq 100 ]; then
    echo ""
    echo -e "$yellow[eFa-NG]$clean Updates are available for this system.$clean"
    echo ""
    local yesno
    read -p "Do you want to apply updates now? (y/N): " yesno || yesno="n"
    if [[ $yesno =~ ^[Yy] ]]; then
      echo ""
      echo -e "$green[eFa-NG]$clean Updating system packages..."
      dnf -y update
      echo ""
      echo -e "$green[eFa-NG]$clean Reloading web and mail services..."
      systemctl reload php-fpm httpd 2>/dev/null || true
      systemctl reload postfix 2>/dev/null || true
      eFaVERSION="$(head -n 1 /etc/eFa-Version 2>/dev/null || echo '6.0.6')"
      echo ""
      echo -e "$green[eFa-NG]$clean System update completed successfully! (Current version: $bold$eFaVERSION$clean)"
      echo ""
      pause "Press [Enter] to reload configuration console..."
      exec "$0" "$@"
    else
      echo -e "$green[eFa-NG]$clean Update cancelled."
      pause
    fi
  else
    echo -e "$red[eFa-NG] An error occurred while checking for updates.$clean"
    pause
  fi
}

# Reboot function
func_reboot() {
  local rebootmenu=1
  while [ $rebootmenu -eq 1 ]; do
    func_echo-header
    echo -e "Are you sure you want to reboot this host?"
    echo -e ""
    echo -e "Y)  Yes I am sure"
    echo -e "N)  No take me back!"
    echo -e ""
    echo -e -n "$green[eFa-NG]$clean : "
    local choice
    read choice || return
    case $choice in
      Y|y) reboot && exit 0 ;;
      N|n) return ;;
      *) echo -e "Error \"$choice\" is not an option..." && sleep 1 ;;
    esac
  done
}

