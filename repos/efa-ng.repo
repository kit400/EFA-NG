[efa-ng]
name=eFa 6 Repository - Enterprise Linux $releasever ($basearch)
baseurl=https://repo.efa-project.org/efa-ng/centos$releasever/release
        https://raw.githubusercontent.com/E-F-A/eFa6/main/rpm/efa-ng/centos$releasever/release
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://repo.efa-project.org/efa-ng/RPM-GPG-KEY-EFA-NG
       https://raw.githubusercontent.com/E-F-A/eFa6/main/rpm/efa-ng/RPM-GPG-KEY-EFA-NG
enabled=1
priority=10

